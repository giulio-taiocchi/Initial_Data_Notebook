Cell[BoxData[
 RowBox[{"BulkFunctions", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            SuperscriptBox["S", "2"], 
            SuperscriptBox["E", 
             RowBox[{
              RowBox[{
               RowBox[{"-", 
                SuperscriptBox["u", "4"]}], "B1in"}], "-", 
              RowBox[{
               SuperscriptBox["u", "4"], "B2in"}]}]], 
            RowBox[{"Cosh", "[", 
             RowBox[{
              SuperscriptBox["u", "4"], "Gin"}], "]"}]}], "==", 
           SuperscriptBox["u", 
            RowBox[{"-", "2"}]]}], ",", 
          RowBox[{
           RowBox[{
            SuperscriptBox["S", "2"], 
            SuperscriptBox["E", 
             RowBox[{
              RowBox[{
               SuperscriptBox["u", "4"], "B1in"}], "-", 
              RowBox[{
               SuperscriptBox["u", "4"], "B2in"}]}]], 
            RowBox[{"Cosh", "[", 
             RowBox[{
              SuperscriptBox["u", "4"], "Gin"}], "]"}]}], "==", 
           SuperscriptBox["u", 
            RowBox[{"-", "2"}]]}], ",", 
          RowBox[{
           RowBox[{
            SuperscriptBox["S", "2"], " ", 
            SuperscriptBox["E", 
             RowBox[{
              RowBox[{"-", 
               SuperscriptBox["u", "4"]}], "B2in"}]], 
            RowBox[{"Sinh", "[", 
             RowBox[{
              SuperscriptBox["u", "4"], "Gin"}], "]"}]}], "==", 
           RowBox[{
            SuperscriptBox["u", 
             RowBox[{"-", "2"}]], "a"}]}], ",", 
          RowBox[{
           RowBox[{
            SuperscriptBox["S", "2"], 
            SuperscriptBox["E", 
             RowBox[{"2", 
              SuperscriptBox["u", "4"], "B2in"}]]}], "==", 
           SuperscriptBox["u", 
            RowBox[{"-", "2"}]]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"S", ",", "Gin", ",", "B1in", ",", "B2in"}], "}"}]}], "]"}], 
      "[", 
