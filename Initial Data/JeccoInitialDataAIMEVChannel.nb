Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"S", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["a", "2"]}], ")"}], 
       RowBox[{"1", "/", "6"}]], "u"]}]}], ",", 
   RowBox[{"Gin", "\[Rule]", 
    FractionBox[
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"-", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["a", "2"]}]]}], "-", 
        RowBox[{"a", " ", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["a", "2"]}]]}]}], 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["a", "2"]}]], "]"}], 
     SuperscriptBox["u", "4"]]}], ",", 
   RowBox[{"B1in", "\[Rule]", "0"}], ",", 
   RowBox[{"B2in", "\[Rule]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"Log", "[", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          SuperscriptBox["a", "2"]}], ")"}], 
        RowBox[{"1", "/", "6"}]], "]"}], 
      SuperscriptBox["u", "4"]]}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.942906378411127*^9, 3.9466403894916477`*^9},
 CellLabel->
  "Out[343]=",ExpressionUUID->"6989e7b5-4e95-4c61-a43f-e7c15fec324a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"S", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
