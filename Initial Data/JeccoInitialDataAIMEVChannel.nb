         "2"]]}], 
      RowBox[{"u0d", "[", 
       RowBox[{"x", ",", "y"}], "]"}], " ", 
      RowBox[{"u1d", "[", 
       RowBox[{"x", ",", "y"}], "]"}]}], ";"}], "*)"}]}]}]], "Input",
