                  RowBox[{"u2d", "[", 
                   RowBox[{"x", ",", "y"}], "]"}], "2"]}], ")"}]}]}], ")"}], 
            FractionBox[
             RowBox[{"-", "1"}], "2"]]}], ")"}]}]}], 
       RowBox[{"(*", 
        RowBox[{",", 
