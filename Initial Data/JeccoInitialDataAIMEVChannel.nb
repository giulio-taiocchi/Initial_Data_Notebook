Cell[BoxData[
 RowBox[{
  RowBox[{"uof\[Rho]Rule", "=", 
   RowBox[{
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"\[Rho]", ",", "x", ",", "y"}], "]"}], ",", 
          RowBox[{"{", "\[Rho]", "}"}]}], "]"}], "==", 
