       SuperscriptBox["u", "4"]]}]}]}], "}"}], "//", "TeXForm"}]], "Input",
 CellChangeTimes->{{3.942742139598974*^9, 3.942742186566947*^9}},
 CellLabel->
  "In[344]:=",ExpressionUUID->"5cf10b53-7637-4b46-b1f2-dd951fd72d89"],

Cell["\<\
\\left\\{S\\to -\\frac{\\sqrt[6]{1-a^2}}{u},\\text{Gin}\\to \\frac{\\log \
\\left(\\frac{-\\sqrt{1-a^2} \
a-\\sqrt{1-a^2}}{a^2-1}\\right)}{u^4},\\text{B1in}\\to
   0,\\text{B2in}\\to -\\frac{\\log \
\\left(\\sqrt[6]{1-a^2}\\right)}{u^4}\\right\\}\
\>", "Output",
 CellChangeTimes->{3.942742186984234*^9, 3.942906378438459*^9, 
  3.9466403902212677`*^9},
 CellLabel->
  "Out[344]//TeXForm=",ExpressionUUID->"2bd34468-d665-45c7-9b49-aaef7665c6df"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["a3", "Subsubsection",
 CellChangeTimes->{{3.914403368967689*^9, 3.914403370079873*^9}, {
  3.915886929229816*^9, 3.915886929926671*^9}, {3.916399106381598*^9, 
  3.9163991070986223`*^9}, {3.91770134637735*^9, 3.917701347839013*^9}, {
  3.92054700193959*^9, 3.920547002648285*^9}, {3.920617676573906*^9, 
  3.920617677213867*^9}, {3.920624607081502*^9, 
  3.92062460776749*^9}},ExpressionUUID->"0091f051-570b-4749-8399-\
bf8cc6233225"],

Cell["\<\
Here I compute the initial data for a3. In the limit at infinity, \[Rho] goes \
to zero, as u. Anyway, they don\[CloseCurlyQuote]t have the same asymptotic \
behaviour so we need to take the expansion of A, substitute u to its \
expression that depends on  \[Rho], and expand in terms of \[Rho] around \
infinity (where \[Rho]=0). In this way we have an expression of our variable \
in terms of \[Rho] at infinity that has to match the expression for A in the \
Turbulence draft (Eq. 3.7).\
\>", "Text",
 CellChangeTimes->{{3.914403374274818*^9, 3.914403567591299*^9}, {
  3.914404745208949*^9, 
  3.914404766022025*^9}},ExpressionUUID->"897d8491-9103-48bf-88ba-\
884376f3a804"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AExp", "=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["u", "2"]], "+", 
    RowBox[{
     SuperscriptBox["u", "2"], " ", 
     RowBox[{"a3", "[", 
      RowBox[{"t", ",", "u", ",", "x", ",", "y"}], "]"}]}], "+", 
    FractionBox[
     RowBox[{"2", " ", 
      RowBox[{"\[Xi]", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "u"], "+", 
    SuperscriptBox[
     RowBox[{"\[Xi]", "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}], "2"], "-", 
    RowBox[{"2", " ", 
     RowBox[{
      SuperscriptBox["\[Xi]", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"1", ",", "0", ",", "0"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9144044346418753`*^9, 3.914404455837296*^9}, {
  3.915169053500782*^9, 3.915169061246023*^9}, {3.9285745845757303`*^9, 
  3.928574611280355*^9}},
 CellLabel->
  "In[107]:=",ExpressionUUID->"d4abdf1a-6d6b-4555-bd58-f56e72c80f11"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AExpOf\[Rho]", "=", 
  RowBox[{
   RowBox[{"AExp", "/.", 
    RowBox[{"u", "->", 
