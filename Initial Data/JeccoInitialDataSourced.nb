 RowBox[{
  RowBox[{"MyGrid", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"uValues", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "u"}], "]"}], "]"}], ",", 
       RowBox[{"xValues", "[", 
        RowBox[{"[", "x", "]"}], "]"}], ",", 
       RowBox[{"yValues", "[", 
        RowBox[{"[", "y", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"uValues", "//", "Length"}]}], "}"}], ",", 
