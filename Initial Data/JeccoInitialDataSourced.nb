Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"S0transp", "[", 
    RowBox[{
    "t_", ",", "t0_", ",", "tau_", ",", "v_", ",", "A_", ",", "x_", ",", 
     "x0_", ",", "sigmax_", ",", "y_", ",", "y0_", ",", "sigmay_"}], "]"}], ":=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"(", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"Tanh", "[", 
            FractionBox[
             RowBox[{"t", "-", "t0"}], "tau"], "]"}]}], ")"}], "A", "  ", 
         FractionBox["1", 
          RowBox[{
           RowBox[{"(", "sigmax", " ", ")"}], " "}]], 
         RowBox[{"Exp", "[", 
          FractionBox[
           RowBox[{"-", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"x", "+", 
               RowBox[{"v", " ", "t"}], " ", "-", "x0"}], ")"}], "2"]}], 
           RowBox[{"2", " ", 
            SuperscriptBox[
             RowBox[{"(", "sigmax", " ", ")"}], "2"]}]], "]"}], 
         FractionBox["1", 
          RowBox[{
           RowBox[{"(", "sigmay", " ", ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"2", "Pi"}], ")"}]}]], 
         RowBox[{"Exp", "[", 
          FractionBox[
           RowBox[{"-", 
            SuperscriptBox[
             RowBox[{"(", " ", 
              RowBox[{"y", " ", "-", "y0"}], ")"}], "2"]}], 
           RowBox[{"2", " ", 
            SuperscriptBox[
             RowBox[{"(", "sigmay", " ", ")"}], "2"]}]], "]"}]}], ")"}]}], 
      ")"}], 
     FractionBox[
      RowBox[{"-", "1"}], "2"]], "//", "Simplify"}]}], ";"}]], "Input",
