       RowBox[{"(*", 
        RowBox[{"Fix", " ", "scientific", " ", "notation"}], "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"x", ":", 
          RowBox[{"(", 
           RowBox[{"DigitCharacter", ".."}], ")"}]}], "~~", "\"\<.\>\"", "~~", 
         RowBox[{"(", 
          RowBox[{"y", ":", 
           RowBox[{
            RowBox[{"Except", "[", "DigitCharacter", "]"}], ".."}]}], ")"}]}],
         ":>", 
        RowBox[{"x", "<>", "y"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"Remove", " ", "unnecessary", " ", "dots"}], "*)"}], 
       RowBox[{"\"\<Pi\>\"", "->", "\"\<pi\>\""}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Mathematica", " ", 
          RowBox[{"uses", "'"}], 
          RowBox[{"Pi", "'"}]}], ",", 
         RowBox[{"Julia", " ", 
          RowBox[{"uses", "'"}], 
          RowBox[{"pi", "'"}]}]}], "*)"}], 
       RowBox[{"\"\<Tanh\>\"", "->", "\"\<tanh\>\""}]}], "}"}]}], "]"}]}], 
