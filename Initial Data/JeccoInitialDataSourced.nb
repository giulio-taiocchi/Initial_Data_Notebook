       RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]}], ")"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"0.00005`", "\[VeryThinSpace]", "+", 
      RowBox[{"1.`", " ", 
       RowBox[{"a3", "[", 
        RowBox[{"t", ",", "0", ",", "x", ",", "y"}], "]"}]}]}], ")"}], " ", 
    "\[Rho]"}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "\[Rho]", "]"}], "2"],
    SeriesData[$CellContext`\[Rho], 0, {}, -2, 2, 1],
    Editable->False]}],
  SeriesData[$CellContext`\[Rho], 0, {
   1., 2. $CellContext`\[Xi][$CellContext`t, $CellContext`x, $CellContext`y], \
$CellContext`\[Xi][$CellContext`t, $CellContext`x, $CellContext`y]^2 - 2 
    Derivative[
     1, 0, 0][$CellContext`\[Xi]][$CellContext`t, $CellContext`x, \
$CellContext`y], 0.00005 + 
    1. $CellContext`a3[$CellContext`t, 
       0, $CellContext`x, $CellContext`y]}, -2, 2, 1],
  Editable->False]], "Output",
