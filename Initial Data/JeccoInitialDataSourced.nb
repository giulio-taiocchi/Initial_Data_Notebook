              RowBox[{"y", ":", 
               RowBox[{
                RowBox[{"Except", "[", "DigitCharacter", "]"}], ".."}]}], 
              ")"}]}], ":>", 
            RowBox[{"x", "<>", "y"}]}], ",", 
           RowBox[{"\"\<Pi\>\"", "->", "\"\<pi\>\""}], ",", 
           RowBox[{"\"\<Tanh\>\"", "->", "\"\<tanh\>\""}], ",", 
           RowBox[{"\"\<Sech\>\"", "->", "\"\<sech\>\""}], ",", 
