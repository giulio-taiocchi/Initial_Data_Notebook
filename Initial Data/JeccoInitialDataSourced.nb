Cell[BoxData["\<\"Sz_y(t, x, y, GS ::LC) = (y*GS.Amp*(1 + tanh((t - \
GS.t0)/GS.tau)))/((1 + x^2/GS.Lsigmax^2)*(y^2/GS.Lsigmay + GS.Lsigmay)^2*(1 + \
(GS.Amp*(1 + tanh((t - GS.t0)/GS.tau)))/((1 + x^2/GS.Lsigmax^2)*(1 + \
y^2/GS.Lsigmay^2)))^1.5)\"\>"], "Output",
