Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"uof\[Rho]", "[", 
    RowBox[{"\[Rho]s_", ",", "xs_", ",", "ys_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"rof\[Rho]", "[", 
          RowBox[{"[", "2", "]"}], "]"}], 
         RowBox[{"-", "1"}]], "/.", 
        RowBox[{"c1Rule", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
       RowBox[{"\[Xi]", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"t", ",", "x", ",", "y"}], "}"}], ",", "0"}], "]"}]}]}], "/.", 
      RowBox[{"\[Rho]", "->", "\[Rho]s"}]}], "/.", 
     RowBox[{"x", "->", "xs"}]}], "/.", 
    RowBox[{"y", "->", "ys"}]}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.915181102411641*^9, 3.915181141786165*^9}, {
   3.915181186866778*^9, 3.915181312644001*^9}, {3.9152666296445827`*^9, 
