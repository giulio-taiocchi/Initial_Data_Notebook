Cell[BoxData[
 RowBox[{
  RowBox[{"FExp", "=", 
   RowBox[{
    RowBox[{"u", " ", 
     RowBox[{"f1", "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "+", 
    RowBox[{
     SuperscriptBox["\[Xi]", 
      TagBox[
       RowBox[{"(", 
        RowBox[{"0", ",", "1", ",", "0"}], ")"}],
       Derivative],
      MultilineFunction->None], "[", 
     RowBox[{"t", ",", "x", ",", "y"}], "]"}], "+", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"4", " "}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "4"}], " ", 
       RowBox[{"f1", "[", 
        RowBox[{"t", ",", "x", ",", "y"}], "]"}], " ", 
       RowBox[{"\[Xi]", "[", 
        RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"+", "3"}], " ", 
        RowBox[{
         SuperscriptBox["\[ScriptCapitalG]", 
          TagBox[
           RowBox[{"(", 
            RowBox[{"0", ",", "0", ",", "1"}], ")"}],
           Derivative],
          MultilineFunction->None], "[", 
         RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"+", "3"}], " ", 
        RowBox[{
         SuperscriptBox["\[ScriptCapitalP]", 
          TagBox[
           RowBox[{"(", 
            RowBox[{"0", ",", "1", ",", "0"}], ")"}],
           Derivative],
          MultilineFunction->None], "[", 
         RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "*)"}], ")"}], 
     SuperscriptBox["u", "2"]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.914405049066926*^9, 3.9144050824646873`*^9}, {
