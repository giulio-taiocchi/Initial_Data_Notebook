Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"rof\[Rho]2", "=", 
   RowBox[{
    RowBox[{"r", "/.", 
     RowBox[{"DSolve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"r", "[", 
             RowBox[{"\[Rho]", ",", "x", ",", "y"}], "]"}], ",", 
            RowBox[{"{", "\[Rho]", "}"}]}], "]"}], "==", 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{"-", "1"}], 
             SuperscriptBox["\[Rho]", "2"]], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"(*", 
                   RowBox[{"b", "[", 
                    RowBox[{"x", ",", "y"}], "]"}], "*)"}], 
                  RowBox[{"b", " ", "\[Rho]"}], ")"}], "3"], 
                RowBox[{"(", 
                 RowBox[{
                  SuperscriptBox[
                   RowBox[{"u1d", "[", 
                    RowBox[{"x", ",", "y"}], "]"}], "2"], "+", 
                  SuperscriptBox[
                   RowBox[{"u2d", "[", 
                    RowBox[{"x", ",", "y"}], "]"}], "2"]}], ")"}]}]}], ")"}], 
             
             FractionBox[
              RowBox[{"-", "1"}], "2"]]}], ")"}]}], ",", 
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{"1", ",", "x", ",", "y"}], "]"}], "==", "1"}]}], "}"}], ",",
        "r", ",", 
       RowBox[{"{", 
        RowBox[{"\[Rho]", ",", "x", ",", "y"}], "}"}]}], "]"}]}], "//", 
    "Flatten"}]}], "*)"}]], "Input",
 CellChangeTimes->{
  3.9435321674494133`*^9, {3.9435322965334806`*^9, 3.943532387437818*^9}, 
   3.947587766924358*^9, 3.948358545939365*^9},
 CellLabel->
