Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"S0Exp", "[", 
    RowBox[{
    "t_", ",", "t0_", ",", "tau_", ",", "A_", ",", "x_", ",", "x0_", ",", 
     "sigmax_", ",", "y_", ",", "y0_", ",", "sigmay_"}], "]"}], ":=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"1", "+", 
         SuperscriptBox["E", 
          FractionBox[
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"t", "-", "t0"}], ")"}]}], "tau"]]}]], "A", "  ", 
       FractionBox["1", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", "sigmax", " ", ")"}], "2"], " ", "2", "Pi"}]], 
       RowBox[{"Exp", "[", 
        FractionBox[
         RowBox[{"-", 
