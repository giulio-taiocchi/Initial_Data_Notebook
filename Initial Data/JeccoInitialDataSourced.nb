        RowBox[{"expr3", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<Pi\>\"", "->", "\"\<pi\>\""}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"expr5", "=", 
