Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"uof\[Rho]", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Rho]s", ",", "xs", ",", "ys"}], "}"}], ",", 
