Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox["1", 
    SuperscriptBox["\[Rho]", "2"]], "+", 
   FractionBox[
    RowBox[{"2.`", " ", 
     RowBox[{"\[Xi]", "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "\[Rho]"], "+", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"\[Xi]", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}], "2"], "-", 
