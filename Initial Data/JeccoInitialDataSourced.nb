Cell["\<\
yMin = xMin;
yMax = xMax;
yNodes = xNodes;
Deltay = Abs[yMin - yMax]/yNodes;
yValues = Table[yMin + i Deltay, {i, 0, yNodes - 1}];\
\>", "Input",
 CellChangeTimes->{{3.950011409830853*^9, 3.950011420137301*^9}},
