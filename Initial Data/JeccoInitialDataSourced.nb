 RowBox[{
  RowBox[{"newExpr", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"expr", "/.", " ", "rules"}], "//", "Simplify"}], "//", 
    "FortranForm"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"First", ",", 
    RowBox[{"replace", " ", "GS", 
     RowBox[{"(", "...", ")"}], " ", "safely"}]}], "*)"}], 
  RowBox[{
   RowBox[{"expr1", "=", 
    RowBox[{"StringReplace", "[", 
     RowBox[{
      RowBox[{"ToString", "[", "newExpr", "]"}], ",", 
      RowBox[{
       RowBox[{"\"\<GS(\>\"", "~~", 
        RowBox[{"(", 
         RowBox[{"param", ":", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"LetterCharacter", "|", "DigitCharacter"}], ")"}], 
           ".."}]}], ")"}], "~~", "\"\<)\>\""}], ":>", 
       RowBox[{"\"\<GS.\>\"", "<>", "param"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Then", ",", 
    RowBox[{
    "process", " ", "exponentiation", " ", "and", " ", "other", " ", "fixes", 
     " ", "separately"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expr2", "=", 
   RowBox[{"StringReplace", "[", 
    RowBox[{"expr1", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<E**\>\"", "->", "\"\<MathConstants.e^\>\""}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"expr3", "=", 
   RowBox[{"StringReplace", "[", 
    RowBox[{"expr2", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<**\>\"", "->", "\"\<^\>\""}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expr4", "=", 
   RowBox[{"StringReplace", "[", 
    RowBox[{"expr3", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<**\>\"", "->", "\"\<^\>\""}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "Fix", " ", "power", " ", "notation", " ", "after", " ", "GS", " ", 
         "replacement"}], "*)"}], 
       RowBox[{
        RowBox[{"\"\<e\>\"", "~~", 
         RowBox[{"(", 
          RowBox[{"x", ":", 
           RowBox[{"DigitCharacter", ".."}]}], ")"}]}], ":>", 
