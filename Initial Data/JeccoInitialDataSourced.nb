Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"uof\[Rho]", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Rho]s", ",", "xs", ",", "ys"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"uof\[Rho]", "/.", 
         RowBox[{"c1Rule", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], 
        RowBox[{"(*", 
         RowBox[{"/.", 
          RowBox[{"\[Xi]", "->", 
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"t", ",", "x", ",", "y"}], "}"}], ",", "0"}], "]"}]}]}],
          "*)"}], "/.", 
        RowBox[{"\[Rho]", "->", "\[Rho]s"}]}], "/.", 
       RowBox[{"x", "->", "xs"}]}], "/.", 
      RowBox[{"y", "->", "ys"}]}]}], "]"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.9458596051886053`*^9, 3.945859610622501*^9}, {
   3.945862967306843*^9, 3.9458629955848*^9}, {3.94586312258565*^9, 
   3.945863156359807*^9}, 3.9458641394966497`*^9},
