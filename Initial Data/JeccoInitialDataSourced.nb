Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"GetuDomain", "[", 
    RowBox[{
    "uOutMin_", ",", "uOutmax_", ",", "uOutDomains_", ",", "uOutNodes_", ",", 
     "uInnNodes_", ",", "IntfaceNodes_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"uu", "=", "uOutMin"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"XInn", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Cos", "[", 
           RowBox[{"Pi", " ", 
            FractionBox["i", 
             RowBox[{"uInnNodes", "-", "1"}]]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"uInnNodes", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
