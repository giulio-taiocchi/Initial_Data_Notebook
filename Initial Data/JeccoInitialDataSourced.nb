yMin = xMin;
yMax = xMax;
yNodes = 55;
Deltay = Abs[yMin - yMax]/yNodes;
yValues = Table[yMin + i Deltay, {i, 0, yNodes - 1}];\
\>", "Input",
 CellChangeTimes->{{3.950011409830853*^9, 3.950011420137301*^9}, {
  3.956740400357086*^9, 3.956740400420615*^9}, {3.957083312342566*^9, 
  3.957083312455461*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"4f563ebb-b1ba-4b2c-9323-5090eee9b1c0"]
}, Open  ]],

