           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", " ", 
              RowBox[{
               RowBox[{"y", " ", 
                FractionBox[
                 RowBox[{"2", "Pi"}], "L"]}], "-", "y0"}], ")"}], 
             FractionBox[
              RowBox[{"2", "Pi"}], "L"]}], ")"}], "2"]}], 
         RowBox[{"2", " ", 
          SuperscriptBox[
           RowBox[{"(", "sigmay", " ", ")"}], "2"]}]], "]"}]}]}], ")"}], 
    FractionBox[
     RowBox[{"-", "1"}], "2"]]}], ";"}]], "Input",
