      RowBox[{"newExpr", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"expr", "/.", " ", "rules"}], "//", "Simplify"}], "//", 
        "FortranForm"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"expr1", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{
         RowBox[{"ToString", "[", "newExpr", "]"}], ",", 
         RowBox[{
          RowBox[{"\"\<GS(\>\"", "~~", 
           RowBox[{"(", 
            RowBox[{"param", ":", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"LetterCharacter", "|", "DigitCharacter"}], ")"}], 
              ".."}]}], ")"}], "~~", "\"\<)\>\""}], ":>", 
          RowBox[{"\"\<GS.\>\"", "<>", "param"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"expr2", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"expr1", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<E**\>\"", "->", "\"\<MathConstants.e^\>\""}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"expr3", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"expr2", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<**\>\"", "->", "\"\<^\>\""}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"expr4", "=", 
