Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"S0", "[", 
    RowBox[{
    "t_", ",", "t0_", ",", "tau_", ",", "A_", ",", "x_", ",", "x0_", ",", 
     "sigmax_", ",", "y_", ",", "y0_", ",", "sigmay_"}], "]"}], ":=", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"Exp", "[", 
      FractionBox[
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"(", " ", 
          RowBox[{"t", " ", "-", "t0"}], ")"}], "2"]}], 
       RowBox[{"2", "  ", 
        SuperscriptBox[
         RowBox[{"tau", " "}], "2"]}]], "]"}], "A", "  ", 
     RowBox[{"(*", 
      FractionBox["1", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", "sigmax", " ", ")"}], "2"], " ", "2", "Pi"}]], "*)"}], 
     RowBox[{"Exp", "[", 
      FractionBox[
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"(", " ", 
          RowBox[{"x", " ", "-", "x0"}], ")"}], "2"]}], 
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"L", " ", "sigmax"}], " ", ")"}], "2"]}]], "]"}], 
     RowBox[{"(*", 
      FractionBox["1", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", "sigmay", " ", ")"}], "2"], " ", "2", "Pi"}]], "*)"}], 
     RowBox[{"Exp", "[", 
      FractionBox[
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"y", " ", "-", "y0"}], ")"}], "2"]}], 
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"L", " ", "sigmay"}], " ", ")"}], "2"]}]], "]"}]}]}]}], 
