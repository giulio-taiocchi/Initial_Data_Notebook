          SuperscriptBox[
           RowBox[{"(", "sigmay", " ", ")"}], "2"], " ", "2", "Pi"}]], "*)"}], 
       RowBox[{"Exp", "[", 
        FractionBox[
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"y", " ", "-", "y0"}], ")"}], "2"]}], 
         RowBox[{"2", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"L", " ", "sigmay"}], " ", ")"}], "2"]}]], "]"}]}]}], 
     ")"}], 
    FractionBox[
     RowBox[{"-", "1"}], "2"]]}], ";"}]], "Input",
