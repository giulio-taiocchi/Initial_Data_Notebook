             FractionBox[
              RowBox[{"2", "Pi"}], "L"]}], ")"}], "2"]}], 
         RowBox[{"2", " ", 
          SuperscriptBox[
           RowBox[{"(", "sigmax", " ", ")"}], "2"]}]], "]"}], 
