Cell[BoxData["\<\"Sz_y(t, x, y, GS ::PertSource) = (GS.Amp*(y - GS.y0)*(1 + \
tanh((t - GS.t0)/GS.tau)))/(2*exp(((x - GS.x0)^2/GS.sigmax^2 + (y - \
GS.y0)^2/GS.sigmay^2)/(2*L^2))*L^2*GS.sigmay^2)\"\>"], "Output",
 CellChangeTimes->{3.950350105137796*^9, 3.955417117583517*^9, 
