Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"S0tilt", "[", 
     RowBox[{
     "t_", ",", "t0_", ",", "tau_", ",", "A_", ",", "x_", ",", "x0_", ",", 
      "sigmax_", ",", "y_", ",", "y0_", ",", "sigmay_", ",", "phi_"}], "]"}], 
    ":=", 
    RowBox[{
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Tanh", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"t", "-", "t0"}], ")"}], "/", "tau"}], "]"}]}], ")"}], "*",
        "A", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"x", "-", "x0"}], ")"}], " ", 
                 RowBox[{"Cos", "[", "phi", "]"}]}], "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"y", "-", "y0"}], ")"}], " ", 
                 RowBox[{"Sin", "[", "phi", "]"}]}]}], ")"}], "^", "2"}], 
             ")"}], "/", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"L", " ", "sigmax"}], ")"}], "^", "2"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"(", 
                   RowBox[{"x", "-", "x0"}], ")"}]}], " ", 
                 RowBox[{"Sin", "[", "phi", "]"}]}], "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"y", "-", "y0"}], ")"}], " ", 
                 RowBox[{"Cos", "[", "phi", "]"}]}]}], ")"}], "^", "2"}], 
             ")"}], "/", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"L", " ", "sigmay"}], ")"}], "^", "2"}]}]}], ")"}]}], 
        "]"}]}]}], "//", "FullSimplify"}]}], ";"}], "\n"}]], "Input",
