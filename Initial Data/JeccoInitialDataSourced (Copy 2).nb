  3.92062460776749*^9}},ExpressionUUID->"b6fce2b0-105c-463c-95cf-\
8c2ebc172533"],

Cell["\<\
Here I compute the initial data for a3. In the limit at infinity, \[Rho] goes \
to zero, as u. Anyway, they don\[CloseCurlyQuote]t have the same asymptotic \
behaviour so we need to take the expansion of A, substitute u to its \
expression that depends on  \[Rho], and expand in terms of \[Rho] around \
infinity (where \[Rho]=0). In this way we have an expression of our variable \
in terms of \[Rho] at infinity that has to match the expression for A in the \
Turbulence draft (Eq. 3.7).\
\>", "Text",
 CellChangeTimes->{{3.914403374274818*^9, 3.914403567591299*^9}, {
  3.914404745208949*^9, 
  3.914404766022025*^9}},ExpressionUUID->"5bc71216-2472-44eb-9fbe-\
5ee27e8526ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AExp", "=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["u", "2"]], "+", 
    RowBox[{"u", " ", 
     RowBox[{"a3", "[", 
      RowBox[{"t", ",", "u", ",", "x", ",", "y"}], "]"}]}], "+", 
    FractionBox[
     RowBox[{"2", " ", 
      RowBox[{"\[Xi]", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "u"], "+", 
    SuperscriptBox[
     RowBox[{"\[Xi]", "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}], "2"], "-", 
    RowBox[{"2", " ", 
     RowBox[{
      SuperscriptBox["\[Xi]", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"1", ",", "0", ",", "0"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]}]}], ";"}]], "Input",
