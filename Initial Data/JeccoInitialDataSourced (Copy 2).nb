  RowBox[{"(*", 
   RowBox[{"Function", " ", "to", " ", "process", " ", "expressions"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"processExpression", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "newExpr", ",", "expr1", ",", "expr2", ",", "expr3", ",", "expr4"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"newExpr", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"expr", "/.", " ", "rules"}], "//", "Simplify"}], "//", 
        "FortranForm"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"expr1", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{
         RowBox[{"ToString", "[", "newExpr", "]"}], ",", 
         RowBox[{
          RowBox[{"\"\<GS(\>\"", "~~", 
           RowBox[{"(", 
            RowBox[{"param", ":", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"LetterCharacter", "|", "DigitCharacter"}], ")"}], 
              ".."}]}], ")"}], "~~", "\"\<)\>\""}], ":>", 
          RowBox[{"\"\<GS.\>\"", "<>", "param"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"expr2", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"expr1", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<E**\>\"", "->", "\"\<MathConstants.e^\>\""}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"expr3", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"expr2", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<**\>\"", "->", "\"\<^\>\""}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"expr4", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"expr3", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<Pi\>\"", "->", "\"\<pi\>\""}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"expr5", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"expr4", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<**\>\"", "->", "\"\<^\>\""}], ",", 
           RowBox[{
            RowBox[{"\"\<e\>\"", "~~", 
             RowBox[{"(", 
              RowBox[{"x", ":", 
               RowBox[{"DigitCharacter", ".."}]}], ")"}]}], ":>", 
            RowBox[{"\"\<e\>\"", "<>", "x"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"x", ":", 
              RowBox[{"(", 
               RowBox[{"DigitCharacter", ".."}], ")"}]}], "~~", "\"\<.\>\"", "~~", 
             RowBox[{"(", 
              RowBox[{"y", ":", 
               RowBox[{
                RowBox[{"Except", "[", "DigitCharacter", "]"}], ".."}]}], 
              ")"}]}], ":>", 
            RowBox[{"x", "<>", "y"}]}], ",", 
           RowBox[{"\"\<Pi\>\"", "->", "\"\<pi\>\""}], ",", 
           RowBox[{"\"\<Tanh\>\"", "->", "\"\<tanh\>\""}], ",", 
           RowBox[{"\"\<Sech\>\"", "->", "\"\<sech\>\""}], ",", 
           RowBox[{"\"\<Sqrt\>\"", "->", "\"\<sqrt\>\""}], ",", 
           RowBox[{"\"\<Sinh\>\"", "->", "\"\<sinh\>\""}], ",", 
           RowBox[{"\"\<Cosh\>\"", "->", "\"\<cosh\>\""}]}], "}"}]}], "]"}]}],
       ";", "\[IndentingNewLine]", "expr5"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SourceType", "=", "\"\<PertSource\>\""}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Process", " ", "all", " ", "expressions"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"expressions", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Sz(t, x, y, GS ::\>\"", "<>", "SourceType", 
       "<>", "\"\<) = \>\"", "<>", 
       RowBox[{"processExpression", "[", 
        RowBox[{"Sz", "[", 
         RowBox[{"t", ",", "x", ",", "y"}], "]"}], "]"}]}], ",", 
      RowBox[{"\"\<Sz_x(t, x, y, GS ::\>\"", "<>", "SourceType", 
       "<>", "\"\<) = \>\"", "<>", 
       RowBox[{"processExpression", "[", 
        RowBox[{"Szx", "[", 
         RowBox[{"t", ",", "x", ",", "y"}], "]"}], "]"}]}], ",", 
      RowBox[{"\"\<Sz_xx(t, x, y, GS ::\>\"", "<>", "SourceType", 
       "<>", "\"\<) =\>\"", "<>", 
