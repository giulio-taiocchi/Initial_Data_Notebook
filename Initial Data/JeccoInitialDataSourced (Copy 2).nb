       RowBox[{"xValues", "//", "Length"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "1", ",", 
       RowBox[{"yValues", "//", "Length"}]}], "}"}]}], "]"}]}], 
