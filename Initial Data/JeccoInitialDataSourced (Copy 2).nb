Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"S0tilt", "[", 
     RowBox[{
     "t_", ",", "t0_", ",", "tau_", ",", "A_", ",", "x_", ",", "x0_", ",", 
      "sigmax_", ",", "y_", ",", "y0_", ",", "sigmay_", ",", "phi_"}], "]"}], 
    ":=", 
