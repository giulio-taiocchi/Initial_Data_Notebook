eae643c4f593"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ClearAll", "[", "ss", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fy", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Obj", "[", 
        RowBox[{"[", 
         RowBox[{"ss", ",", "6", ",", "j", ",", "i", ",", "1"}], "]"}], "]"}],
        ",", 
