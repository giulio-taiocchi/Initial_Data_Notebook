         RowBox[{"\"\<Pseudospectral\>\"", ",", "\"\<Pseudospectral\>\""}], 
         "}"}]}], ",", 
       RowBox[{"PeriodicInterpolation", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"True", ",", "True"}], "}"}]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"d", "[", 
      RowBox[{"6", ",", "0"}], "]"}], "=", 
     RowBox[{"NDSolve`FiniteDifferenceDerivative", "[", 
