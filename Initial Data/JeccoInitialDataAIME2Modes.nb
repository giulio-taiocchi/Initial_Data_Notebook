Cell[BoxData[{
 RowBox[{
  RowBox[{"rof\[Rho]", "=", 
   RowBox[{
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{"\[Rho]", ",", "x", ",", "y"}], "]"}], ",", 
          RowBox[{"{", "\[Rho]", "}"}]}], "]"}], "==", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "1"}], 
           SuperscriptBox["\[Rho]", "2"]], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"b", " ", "\[Rho]"}], ")"}], "3"], 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"u1d", "[", 
                  RowBox[{"x", ",", "y"}], "]"}], "2"], "+", 
                SuperscriptBox[
                 RowBox[{"u2d", "[", 
                  RowBox[{"x", ",", "y"}], "]"}], "2"]}], ")"}]}]}], ")"}], 
           FractionBox[
            RowBox[{"-", "1"}], "2"]]}], ")"}]}], 
       RowBox[{"(*", 
        RowBox[{",", 
         RowBox[{
          RowBox[{"r", "[", "1", "]"}], "==", "1"}]}], "*)"}], "}"}], ",", 
      "r", ",", 
      RowBox[{"{", 
       RowBox[{"\[Rho]", ",", "x", ",", "y"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"rof\[Rho]", "=", 
  RowBox[{
   RowBox[{"r", "/.", "rof\[Rho]"}], "//", "N"}]}]}], "Input",
