Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"Coefficient", "[", 
    RowBox[{"FToMatch", ",", "\[Rho]"}], "]"}], "==", 
   RowBox[{"Coefficient", "[", 
    RowBox[{"FExpOf\[Rho]", ",", "\[Rho]"}], "]"}]}], "*)"}]], "Input",
 CellChangeTimes->{3.916894253159698*^9, 3.917631009017811*^9, 
