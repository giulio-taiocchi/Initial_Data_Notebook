    RowBox[{"u", " ", 
     RowBox[{"f2", "[", 
      RowBox[{"t", ",", "z", ",", "y"}], "]"}]}], "+", 
    RowBox[{
     SuperscriptBox["\[Xi]", 
      TagBox[
       RowBox[{"(", 
        RowBox[{"0", ",", "0", ",", "1"}], ")"}],
       Derivative],
      MultilineFunction->None], "[", 
     RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]}], ";"}]], "Input",
