Cell["\<\
\\left\\{S\\to -\\frac{\\sqrt[6]{1-a^2}}{u},\\text{Gin}\\to \\frac{\\log \
\\left(\\frac{-\\sqrt{1-a^2}
   a-\\sqrt{1-a^2}}{a^2-1}\\right)}{u^4},\\text{B1in}\\to 0,\\text{B2in}\\to \
-\\frac{\\log \\left(\\sqrt[6]{1-a^2}\\right)}{u^4}\\right\\}\
\>", "Output",
 CellChangeTimes->{3.942742186984234*^9, 3.942906378438459*^9, 
  3.9466403902212677`*^9, 3.9875644444249773`*^9},
 CellLabel->
