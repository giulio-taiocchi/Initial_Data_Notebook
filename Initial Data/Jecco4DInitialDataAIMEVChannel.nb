Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fyRule", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"F2ToMatch", ",", "\[Rho]"}], "]"}], "==", 
      RowBox[{"Coefficient", "[", 
       RowBox[{"F2ExpOf\[Rho]", ",", "\[Rho]"}], "]"}]}], ",", 
     RowBox[{"f2", "[", 
      RowBox[{"t", ",", "z", ",", "y"}], "]"}]}], "]"}], "//", 
   "Simplify"}]}]], "Input",
