186e75b0767c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"F2ToMatch", "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"b", " ", "\[Rho]"}], 
        RowBox[{"(*", 
         RowBox[{"ofu", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "x", ",", "y"}], "}"}], "]"}], "*)"}], ")"}], 
       "3"], 
      SuperscriptBox[
       RowBox[{"\[Rho]", 
        RowBox[{"(*", 
         RowBox[{"ofu", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "x", ",", "y"}], "}"}], "]"}], "*)"}]}], "2"]]}], 
    RowBox[{"u0d", "[", 
     RowBox[{"x", ",", "y"}], "]"}], " ", 
    RowBox[{"u2d", "[", 
     RowBox[{"x", ",", "y"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.916404619655147*^9, 3.916404628753805*^9}, {
