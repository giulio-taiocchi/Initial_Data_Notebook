Cell[CellGroupData[{

Cell["a3", "Subsubsection",
 CellChangeTimes->{{3.914403368967689*^9, 3.914403370079873*^9}, {
  3.915886929229816*^9, 3.915886929926671*^9}, {3.916399106381598*^9, 
  3.9163991070986223`*^9}, {3.91770134637735*^9, 3.917701347839013*^9}, {
  3.92054700193959*^9, 3.920547002648285*^9}, {3.920617676573906*^9, 
  3.920617677213867*^9}, {3.920624607081502*^9, 
  3.92062460776749*^9}},ExpressionUUID->"0091f051-570b-4749-8399-\
bf8cc6233225"],

Cell["\<\
Here I compute the initial data for a3. In the limit at infinity, \[Rho] goes \
to zero, as u. Anyway, they don\[CloseCurlyQuote]t have the same asymptotic \
behaviour so we need to take the expansion of A, substitute u to its \
expression that depends on  \[Rho], and expand in terms of \[Rho] around \
infinity (where \[Rho]=0). In this way we have an expression of our variable \
in terms of \[Rho] at infinity that has to match the expression for A in the \
Turbulence draft (Eq. 3.7).\
\>", "Text",
 CellChangeTimes->{{3.914403374274818*^9, 3.914403567591299*^9}, {
  3.914404745208949*^9, 
  3.914404766022025*^9}},ExpressionUUID->"897d8491-9103-48bf-88ba-\
884376f3a804"],

Cell[BoxData[
 RowBox[{
  RowBox[{"AExp", "=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["u", "2"]], "+", 
    RowBox[{"u", " ", 
     RowBox[{"a3", "[", 
      RowBox[{"t", ",", "u", ",", "x", ",", "y"}], "]"}]}], "+", 
    FractionBox[
     RowBox[{"2", " ", 
      RowBox[{"\[Xi]", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "u"], "+", 
    SuperscriptBox[
     RowBox[{"\[Xi]", "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}], "2"], "-", 
    RowBox[{"2", " ", 
     RowBox[{
      SuperscriptBox["\[Xi]", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"1", ",", "0", ",", "0"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9144044346418753`*^9, 3.914404455837296*^9}, {
   3.915169053500782*^9, 3.915169061246023*^9}, {3.9285745845757303`*^9, 
   3.928574611280355*^9}, 3.974897244145499*^9},
 CellLabel->
  "In[290]:=",ExpressionUUID->"d4abdf1a-6d6b-4555-bd58-f56e72c80f11"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AExpOf\[Rho]", "=", 
  RowBox[{"AExp", 
   RowBox[{"(*", 
    RowBox[{"/.", 
     RowBox[{"\[Xi]", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", ",", "z", ",", "y"}], "}"}], ",", "0"}], "]"}]}]}], 
    "*)"}], "//", 
   RowBox[{
    RowBox[{"Series", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", 
       RowBox[{"u", ",", "0", ",", "2"}], "}"}]}], "]"}], "&"}]}]}]], "Input",\

 CellChangeTimes->{{3.914404459485612*^9, 3.9144045291771727`*^9}, {
   3.914404567186452*^9, 3.914404617410006*^9}, {3.91440480488881*^9, 
   3.914404804943371*^9}, {3.914404894619499*^9, 3.914404898991851*^9}, 
   3.914576266141433*^9, 3.914576367467123*^9, 3.914577571698928*^9, {
   3.915084995239422*^9, 3.9150849959639463`*^9}, {3.915094575395151*^9, 
   3.915094575556929*^9}, {3.9151690667012444`*^9, 3.915169066751237*^9}, {
   3.916896096432365*^9, 3.916896096625504*^9}, {3.917690943038653*^9, 
   3.917690943153549*^9}, 3.920528559206553*^9, {3.920629661161664*^9, 
   3.920629667849618*^9}, {3.9285746517595463`*^9, 3.928574673308982*^9}, {
