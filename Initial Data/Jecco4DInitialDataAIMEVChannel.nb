Cell[TextData[{
 "Here we need to consider the definition of the perturbation in terms of the \
radial profile. In the nb where we compute the radial profile, we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", " ", "=", " ", 
    FractionBox[
     SuperscriptBox["e", 
      RowBox[{
       SubscriptBox["ikx", "3"], "-", "i\[Omega]v"}]], 
     RowBox[{"2", 
      SuperscriptBox["u", "2"]}]]}], TraditionalForm]],ExpressionUUID->
  "869efd88-fce5-41ed-ae94-a973eb862fe6"],
 "h(z), "
}], "Text",
 CellChangeTimes->{{3.9388387088925953`*^9, 3.938838849047782*^9}, {
  3.941868259323916*^9, 
  3.941868259861726*^9}},ExpressionUUID->"2bf31793-7f4f-4d60-b9cb-\
f30445daee46"],

