Cell[BoxData[
 InterpretationBox[
  RowBox[{
   FractionBox["1", 
    SuperscriptBox["u", "2"]], "+", 
   FractionBox[
    RowBox[{"2", " ", 
     RowBox[{"\[Xi]", "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "u"], "+", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"\[Xi]", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}], "2"], "-", 
     RowBox[{"2", " ", 
      RowBox[{
       SuperscriptBox["\[Xi]", 
