Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", " ", 
        RowBox[{"x", " ", "-", "x0"}], ")"}], 
       FractionBox[
        RowBox[{"2", "Pi"}], "L"]}], ")"}], "2"]}], 
   RowBox[{"2", " ", 
    SuperscriptBox[
     RowBox[{"(", "sigmax", " ", ")"}], "2"]}]], "//", "Expand"}]], "Input",
