         RowBox[{"ToString", "[", "newExpr", "]"}], ",", 
         RowBox[{
          RowBox[{"\"\<GS(\>\"", "~~", 
           RowBox[{"(", 
            RowBox[{"param", ":", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"LetterCharacter", "|", "DigitCharacter"}], ")"}], 
              ".."}]}], ")"}], "~~", "\"\<)\>\""}], ":>", 
          RowBox[{"\"\<GS.\>\"", "<>", "param"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"expr2", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"expr1", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<E**\>\"", "->", "\"\<MathConstants.e^\>\""}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"expr3", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"expr2", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<**\>\"", "->", "\"\<^\>\""}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"expr4", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"expr3", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<Pi\>\"", "->", "\"\<pi\>\""}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"expr5", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"expr4", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<**\>\"", "->", "\"\<^\>\""}], ",", 
           RowBox[{
            RowBox[{"\"\<e\>\"", "~~", 
