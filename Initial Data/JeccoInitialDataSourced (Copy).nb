Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{"2", " ", 
     SuperscriptBox["\[Pi]", "2"], " ", 
     SuperscriptBox["x", "2"]}], 
    RowBox[{
     SuperscriptBox["L", "2"], " ", 
     SuperscriptBox["sigmax", "2"]}]]}], "+", 
  FractionBox[
   RowBox[{"4", " ", 
    SuperscriptBox["\[Pi]", "2"], " ", "x", " ", "x0"}], 
