 RowBox[{
  RowBox[{
   RowBox[{"processExpression", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "newExpr", ",", "expr1", ",", "expr2", ",", "expr3", ",", "expr4"}], 
