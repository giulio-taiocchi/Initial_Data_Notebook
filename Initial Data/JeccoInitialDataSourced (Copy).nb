Cell[CellGroupData[{

Cell["Exponential Source", "Subsubsection",
 CellChangeTimes->{{3.9501793493094053`*^9, 
  3.9501793805551033`*^9}},ExpressionUUID->"eb58e99a-097f-495a-bab8-\
3091a861085b"],

Cell[BoxData[
 RowBox[{"ClearAll", "[", "L", "]"}]], "Input",
 CellChangeTimes->{{3.950336475162301*^9, 3.950336477613975*^9}},
 CellLabel->
  "In[1409]:=",ExpressionUUID->"6ff871f6-d672-4865-8797-f7635ae6785b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"S0Exp", "[", 
    RowBox[{
    "t_", ",", "t0_", ",", "tau_", ",", "A_", ",", "x_", ",", "x0_", ",", 
     "sigmax_", ",", "y_", ",", "y0_", ",", "sigmay_"}], "]"}], ":=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"1", "+", 
         SuperscriptBox["E", 
          FractionBox[
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"t", "-", "t0"}], ")"}]}], "tau"]]}]], "A", "  ", 
       FractionBox["1", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", "sigmax", " ", ")"}], "2"], " ", "2", "Pi"}]], 
       RowBox[{"Exp", "[", 
        FractionBox[
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", " ", 
              RowBox[{"x", " ", "-", "x0"}], ")"}], 
             FractionBox[
              RowBox[{"2", "Pi"}], "L"]}], ")"}], "2"]}], 
         RowBox[{"2", " ", 
          SuperscriptBox[
           RowBox[{"(", "sigmax", " ", ")"}], "2"]}]], "]"}], 
       FractionBox["1", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", "sigmay", " ", ")"}], "2"], " ", "2", "Pi"}]], 
       RowBox[{"Exp", "[", 
        FractionBox[
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", " ", 
              RowBox[{
               RowBox[{"y", " ", 
                FractionBox[
                 RowBox[{"2", "Pi"}], "L"]}], "-", "y0"}], ")"}], 
             FractionBox[
              RowBox[{"2", "Pi"}], "L"]}], ")"}], "2"]}], 
         RowBox[{"2", " ", 
          SuperscriptBox[
           RowBox[{"(", "sigmay", " ", ")"}], "2"]}]], "]"}]}]}], ")"}], 
    FractionBox[
     RowBox[{"-", "1"}], "2"]]}], ";"}]], "Input",
 CellChangeTimes->{{3.94974055710328*^9, 3.9497405593763638`*^9}, {
  3.9497405948307323`*^9, 3.949740738529636*^9}, {3.9497407876867332`*^9, 
