         RowBox[{"expr3", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<Pi\>\"", "->", "\"\<pi\>\""}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"expr5", "=", 
        RowBox[{"StringReplace", "[", 
         RowBox[{"expr4", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<**\>\"", "->", "\"\<^\>\""}], ",", 
