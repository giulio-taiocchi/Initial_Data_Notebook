Cell[BoxData[
 RowBox[{
  RowBox[{"uof\[Rho]Rule", "=", 
   RowBox[{
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"\[Rho]", ",", "x", ",", "y"}], "]"}], ",", 
          RowBox[{"{", "\[Rho]", "}"}]}], "]"}], "==", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{"u", "[", 
            RowBox[{"\[Rho]", ",", "x", ",", "y"}], "]"}], "2"]}], 
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{"-", "1"}], 
            SuperscriptBox["\[Rho]", "2"]], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"b", " ", "\[Rho]"}], ")"}], "3"], 
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"u1d", "[", 
                   RowBox[{"x", ",", "y"}], "]"}], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"u2d", "[", 
                   RowBox[{"x", ",", "y"}], "]"}], "2"]}], ")"}]}]}], ")"}], 
            FractionBox[
             RowBox[{"-", "1"}], "2"]]}], ")"}]}]}], 
       RowBox[{"(*", 
        RowBox[{",", 
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{"1", ",", "x", ",", "y"}], "]"}], "==", "1"}]}], "*)"}], 
       "}"}], ",", "u", ",", 
      RowBox[{"{", 
       RowBox[{"\[Rho]", ",", "x", ",", "y"}], "}"}]}], "]"}], "//", 
    "Flatten"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.945768490648017*^9, 3.9457684959265127`*^9}, {
