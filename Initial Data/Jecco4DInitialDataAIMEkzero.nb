 RowBox[{"BulkFunctions", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            SuperscriptBox["S", "2"], 
            SuperscriptBox["E", 
             RowBox[{
              RowBox[{"-", 
               SuperscriptBox["u", "3"]}], "Bin"}]], 
            RowBox[{"Cosh", "[", 
             RowBox[{
              SuperscriptBox["u", "3"], "Gin"}], "]"}]}], "==", 
           SuperscriptBox["u", 
            RowBox[{"-", "2"}]]}], ",", 
          RowBox[{
           RowBox[{
            SuperscriptBox["S", "2"], 
            SuperscriptBox["E", 
             RowBox[{
              SuperscriptBox["u", "3"], "Bin"}]], 
            RowBox[{"Cosh", "[", 
             RowBox[{
              SuperscriptBox["u", "3"], "Gin"}], "]"}]}], "==", 
           SuperscriptBox["u", 
            RowBox[{"-", "2"}]]}], ",", 
          RowBox[{
           RowBox[{
            SuperscriptBox["S", "2"], " ", 
            RowBox[{"Sinh", "[", 
             RowBox[{
              SuperscriptBox["u", "3"], "Gin"}], "]"}]}], "==", 
           RowBox[{"(*", 
            SuperscriptBox["u", 
             RowBox[{"-", "2"}]], "*)"}], 
           RowBox[{"u", " ", "a"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"S", ",", "Gin", ",", "Bin"}], "}"}]}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "/.", " ", 
     RowBox[{
      TemplateBox[{"1"},
       "C"], "->", "0"}]}], "/.", " ", 
    RowBox[{
     TemplateBox[{"2"},
      "C"], "->", "0"}]}], "/.", 
   RowBox[{
    TemplateBox[{"3"},
     "C"], "->", "0"}]}]}]], "Input",
