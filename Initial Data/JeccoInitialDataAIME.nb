          RowBox[{"{", "\[Rho]", "}"}]}], "]"}], "==", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "1"}], 
           SuperscriptBox["\[Rho]", "2"]], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"b", " ", "\[Rho]"}], ")"}], "3"], 
              RowBox[{"(", 
