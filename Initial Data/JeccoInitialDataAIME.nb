 RowBox[{
  RowBox[{"FExp", "=", 
   RowBox[{
    RowBox[{"u", " ", 
     RowBox[{"f1", "[", 
      RowBox[{"t", ",", "z", ",", "y"}], "]"}]}], "+", 
    RowBox[{
     SuperscriptBox["\[Xi]", 
      TagBox[
       RowBox[{"(", 
        RowBox[{"0", ",", "1", ",", "0"}], ")"}],
       Derivative],
      MultilineFunction->None], "[", 
