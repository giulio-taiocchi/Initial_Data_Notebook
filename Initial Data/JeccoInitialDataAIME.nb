Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InitialBAnalytic", "[", 
    RowBox[{"u_", ",", "x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    RowBox[{"Log", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"b", " ", 
            RowBox[{"\[Rho]ofu", "[", 
             RowBox[{"{", 
              RowBox[{"u", ",", "x", ",", "y"}], "}"}], "]"}]}], ")"}], "3"], 
         
         SuperscriptBox[
          RowBox[{"u1d", "[", 
           RowBox[{"x", ",", "y"}], "]"}], "2"]}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"b", " ", 
            RowBox[{"\[Rho]ofu", "[", 
             RowBox[{"{", 
              RowBox[{"u", ",", "x", ",", "y"}], "}"}], "]"}]}], ")"}], "3"], 
         
         SuperscriptBox[
          RowBox[{"u2d", "[", 
           RowBox[{"x", ",", "y"}], "]"}], "2"]}]}], ")"}]}], "]"}], 
    SuperscriptBox["u", 
     RowBox[{"-", "3"}]]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9162919834920464`*^9, 3.916292062677742*^9}, {
   3.9162921349197474`*^9, 3.916292142675688*^9}, 3.916292203590354*^9, {
