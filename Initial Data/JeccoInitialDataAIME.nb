                  RowBox[{"x", ",", "y"}], "]"}], "2"]}], ")"}]}]}], ")"}], 
           FractionBox[
            RowBox[{"-", "1"}], "2"]]}], ")"}]}], 
       RowBox[{"(*", 
        RowBox[{",", 
         RowBox[{
          RowBox[{"r", "[", "1", "]"}], "==", "1"}]}], "*)"}], "}"}], ",", 
