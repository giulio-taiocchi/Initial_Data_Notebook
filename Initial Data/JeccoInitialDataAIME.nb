Cell[BoxData[
 RowBox[{
  RowBox[{"a3Data", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"a3", "[", 
          RowBox[{"t", ",", "0", ",", "x", ",", "y"}], "]"}], "/.", 
         "a3Rule"}], "/.", 
        RowBox[{"x", "->", 
         RowBox[{"xValues", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}]}], "/.", 
       RowBox[{"y", "->", 
        RowBox[{"yValues", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}], 
     RowBox[{"(*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        FractionBox[
         RowBox[{
          RowBox[{"RandomReal", "[", "]"}], "-", "0.5"}], "100"]}], ")"}], 
      "*)"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"xValues", "//", "Length"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"yValues", "//", "Length"}]}], "}"}]}], "]"}]}], 
