Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]uxToInt", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], ",", 
       FractionBox[
        RowBox[{
         RowBox[{"Random", "[", "]"}], "-", "0.5"}], "20"]}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"qx", " ", "y"}], "]"}], "+", 
        RowBox[{"RandomFactor", "[", 
         RowBox[{"x", ",", "y"}], "]"}]}], "*)"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "xMin", ",", "xMax", ",", "0.1"}], "}"}], ",", 
     RowBox[{"{", 
