Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InitialB1", "=", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"SeriesCoefficient", "[", 
         RowBox[{
          RowBox[{"InitialBAnalytic", "[", 
           RowBox[{"u", ",", 
            RowBox[{"xValues", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"yValues", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", 
            RowBox[{"uValues", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "0"}], "}"}]}], "]"}], "//",
         "Normal"}], "]"}], 
      RowBox[{"(*", 
       RowBox[{"(", 
        RowBox[{"1", "+", " ", 
         FractionBox[
          RowBox[{
           RowBox[{"RandomReal", "[", "]"}], "-", "0.5"}], "100"]}], ")"}], 
