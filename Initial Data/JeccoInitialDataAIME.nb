Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InitialG", "=", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          FractionBox[
           RowBox[{"Log", "[", 
            FractionBox[
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], " ", 
               SqrtBox[
                RowBox[{"4", "-", 
                 SuperscriptBox["a", "2"]}]]}], "-", 
              RowBox[{"a", " ", 
               SqrtBox[
                RowBox[{"4", "-", 
                 SuperscriptBox["a", "2"]}]]}]}], 
             RowBox[{
              RowBox[{"-", "4"}], "+", 
              SuperscriptBox["a", "2"]}]], "]"}], 
           SuperscriptBox["u", "4"]], "/.", 
          RowBox[{"a", "->", 
           RowBox[{"Parametricgxy", "[", 
            RowBox[{"uValues", "[", 
             RowBox[{"[", "ui", "]"}], "]"}], "]"}]}]}], "/.", 
         RowBox[{"u", "->", 
          RowBox[{"uValues", "[", 
           RowBox[{"[", "ui", "]"}], "]"}]}]}], ",", "$MinPrecision"}], "]"}],
       ",", 
      RowBox[{"{", 
       RowBox[{"ui", ",", "1", ",", 
        RowBox[{"uValues", "//", "Length"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"xi", ",", "1", ",", "xNodes"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"yi", ",", "1", ",", "yNodes"}], "}"}]}], "]"}]}], ";"}], "//",
   "AbsoluteTiming"}]], "Input",
