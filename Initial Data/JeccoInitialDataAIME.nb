             SuperscriptBox[
              RowBox[{"\[Rho]", "[", 
               RowBox[{"u", ",", "x", ",", "y"}], "]"}], "2"]], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"b", " ", 
                   RowBox[{"\[Rho]", "[", 
                    RowBox[{"u", ",", "x", ",", "y"}], "]"}]}], ")"}], "3"], 
                RowBox[{"(", 
                 RowBox[{
                  SuperscriptBox[
                   RowBox[{"u1", "[", 
                    RowBox[{"x", ",", "y"}], "]"}], "2"], "+", 
                  SuperscriptBox[
                   RowBox[{"u2", "[", 
                    RowBox[{"x", ",", "y"}], "]"}], "2"]}], ")"}]}]}], ")"}], 
             
             FractionBox[
              RowBox[{"-", "1"}], "2"]]}], ")"}], 
          RowBox[{"-", "1"}]]}], "}"}], ",", "\[Rho]", ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "x", ",", "y"}], "}"}]}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "*)"}]], "Input",
