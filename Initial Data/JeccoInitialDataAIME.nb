    RowBox[{"-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"b", " ", "\[Rho]"}], 
        RowBox[{"(*", 
         RowBox[{"ofu", "[", 
          RowBox[{"{", 
           RowBox[{"0", ",", "x", ",", "y"}], "}"}], "]"}], "*)"}], ")"}], 
       "3"], 
