Cell[BoxData[
 RowBox[{
  RowBox[{"GetuDomain2", "[", 
   RowBox[{
   "uOutMin_", ",", "uOutmax_", ",", "uOutDomains_", ",", "uOutNodes_", ",", 
    "uInnNodes_", ",", "IntfaceNodes_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"uu", "=", "uOutMin"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"XInn", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Cos", "[", 
          RowBox[{"Pi", " ", 
           FractionBox["i", 
            RowBox[{"uInnNodes", "-", "1"}]]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"uInnNodes", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uInner", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"IntfaceNodes", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "+", "0"}], "2"], "+", 
           RowBox[{
            FractionBox[
             RowBox[{
              RowBox[{"IntfaceNodes", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "-", "0"}], "2"], 
            RowBox[{"XInn", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "uInnNodes"}], "}"}]}], "]"}], ",", 
        "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"XOut", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Cos", "[", 
          RowBox[{"Pi", " ", 
           FractionBox["i", 
            RowBox[{"uOutNodes", "-", "1"}]]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"uOutNodes", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uOut", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              FractionBox["1", "2"], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"IntfaceNodes", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "+", 
                RowBox[{"IntfaceNodes", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", "-", "1"}], "]"}], "]"}]}], ")"}]}], "+", 
             RowBox[{
              FractionBox["1", "2"], 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"IntfaceNodes", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "-", 
                RowBox[{"IntfaceNodes", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", "-", "1"}], "]"}], "]"}]}], ")"}], 
              RowBox[{"XOut", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "uOutNodes"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "2", ",", 
            RowBox[{"IntfaceNodes", "//", "Length"}]}], "}"}]}], "]"}], ",", 
        "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"uOut", ",", 
           RowBox[{"{", "1", "}"}]}], "]"}], "//", "Dimensions"}], "]"}], 
       ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Insert", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"uOut", ",", 
         RowBox[{"{", "1", "}"}]}], "]"}], ",", "uInner", ",", "1"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
