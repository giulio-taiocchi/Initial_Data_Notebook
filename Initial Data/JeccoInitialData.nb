Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rof\[Rho]2", "=", 
  RowBox[{
   RowBox[{"r", "/.", 
    RowBox[{"DSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"r", "[", 
            RowBox[{"\[Rho]", ",", "x", ",", "y"}], "]"}], ",", 
           RowBox[{"{", "\[Rho]", "}"}]}], "]"}], "==", 
         RowBox[{"(", 
          RowBox[{
           FractionBox[
            RowBox[{"-", "1"}], 
            SuperscriptBox["\[Rho]", "2"]], 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"(*", 
                  RowBox[{"b", "[", 
                   RowBox[{"x", ",", "y"}], "]"}], "*)"}], 
                 RowBox[{"b", " ", "\[Rho]"}], ")"}], "3"], 
               RowBox[{"(", 
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"u1d", "[", 
                   RowBox[{"x", ",", "y"}], "]"}], "2"], "+", 
                 SuperscriptBox[
                  RowBox[{"u2d", "[", 
                   RowBox[{"x", ",", "y"}], "]"}], "2"]}], ")"}]}]}], ")"}], 
            FractionBox[
             RowBox[{"-", "1"}], "2"]]}], ")"}]}], ",", 
        RowBox[{
         RowBox[{"r", "[", 
          RowBox[{"1", ",", "x", ",", "y"}], "]"}], "==", "1"}]}], "}"}], ",",
       "r", ",", 
      RowBox[{"{", 
       RowBox[{"\[Rho]", ",", "x", ",", "y"}], "}"}]}], "]"}]}], "//", 
   "Flatten"}]}]], "Input",
 CellChangeTimes->{
  3.9435321674494133`*^9, {3.9435322965334806`*^9, 3.943532387437818*^9}, 
   3.947587766924358*^9},
 CellLabel->
  "In[208]:=",ExpressionUUID->"5fce9688-dee7-4b3a-8792-f0b8e2d316ad"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"Function", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Rho]", ",", "x", ",", "y"}], "}"}], ",", 
    FractionBox[
     RowBox[{"\[Rho]", "-", 
      RowBox[{"\[Rho]", " ", 
       RowBox[{"Hypergeometric2F1", "[", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["1", "3"]}], ",", 
         FractionBox["1", "2"], ",", 
         FractionBox["2", "3"], ",", 
         RowBox[{"-", 
          SuperscriptBox[
           RowBox[{"Cos", "[", 
            FractionBox[
             RowBox[{"\[Pi]", " ", "y"}], "150"], "]"}], "2"]}]}], "]"}]}], 
      "+", 
      RowBox[{"Hypergeometric2F1", "[", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", "3"]}], ",", 
        FractionBox["1", "2"], ",", 
        FractionBox["2", "3"], ",", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["\[Rho]", "3"]}], " ", 
         SuperscriptBox[
          RowBox[{"Cos", "[", 
           FractionBox[
            RowBox[{"\[Pi]", " ", "y"}], "150"], "]"}], "2"]}]}], "]"}]}], 
     "\[Rho]"]}], "]"}], "}"}]], "Output",
 CellChangeTimes->{3.9475673545230293`*^9, 3.947567427856585*^9, 
  3.947587729657517*^9, 3.947587768287582*^9, 3.947587987749316*^9, 
