Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"uof\[Rho]", "[", 
    RowBox[{"\[Rho]s_", ",", "xs_", ",", "ys_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"rof\[Rho]", "[", 
          RowBox[{"[", "2", "]"}], "]"}], 
         RowBox[{"-", "1"}]], "/.", 
        RowBox[{"c1Rule", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
       RowBox[{"\[Xi]", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"t", ",", "x", ",", "y"}], "}"}], ",", "0"}], "]"}]}]}], "/.", 
      RowBox[{"\[Rho]", "->", "\[Rho]s"}]}], "/.", 
