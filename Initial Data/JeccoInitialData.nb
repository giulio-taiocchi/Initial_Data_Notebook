Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RandomFactor2", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_"}], "}"}], "]"}], "=", 
   RowBox[{"(*", 
    RowBox[{"Sum", "["}], "*)"}], 
   RowBox[{
    RowBox[{"RandomCoefficientsy1", "[", 
     RowBox[{"[", "1", "]"}], "]"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"RandomModesy1", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "x"}], "+", 
         RowBox[{
          RowBox[{"RandomModesy1", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "y"}]}], ")"}], " ", "2", " ", 
       RowBox[{"Pi", " ", "/", 
        RowBox[{"(", 
         RowBox[{"xMax", "-", "xMin"}], ")"}]}]}], "+", 
      RowBox[{"RandomOffsetsy1", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"+", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"RandomCoefficientsy1", "[", 
        RowBox[{"[", "i", "]"}], "]"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RandomModesy2", "[", 
           RowBox[{"[", "i", "]"}], "]"}], " ", "2", " ", "Pi", " ", 
          RowBox[{"y", "/", 
           RowBox[{"(", 
            RowBox[{"xMax", "-", "xMin"}], ")"}]}]}], "+", 
         RowBox[{"RandomOffsetsy2", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "*)"}], 
     RowBox[{",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"modesTot", "-", "1"}]}], "}"}]}]}], "]"}], "*)"}], 
  ";"}]], "Input",
