 RowBox[{
  RowBox[{"AExp", "=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["u", "2"]], "+", 
    RowBox[{"u", " ", 
     RowBox[{"a3", "[", 
      RowBox[{"t", ",", "u", ",", "x", ",", "y"}], "]"}]}], "+", 
    FractionBox[
     RowBox[{"2", " ", 
      RowBox[{"\[Xi]", "[", 
       RowBox[{"t", ",", "x", ",", "y"}], "]"}]}], "u"], "+", 
    SuperscriptBox[
     RowBox[{"\[Xi]", "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}], "2"], "-", 
    RowBox[{"2", " ", 
     RowBox[{
      SuperscriptBox["\[Xi]", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"1", ",", "0", ",", "0"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"t", ",", "x", ",", "y"}], "]"}]}]}]}], ";"}]], "Input",
