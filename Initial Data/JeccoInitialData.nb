Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"InitialBAnalytic", "[", 
    RowBox[{"u_", ",", "x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "2"]}], 
    RowBox[{"Log", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"b", " ", 
            RowBox[{"\[Rho]ofu", "[", 
             RowBox[{"{", 
              RowBox[{"u", ",", "x", ",", "y"}], "}"}], "]"}]}], ")"}], "3"], 
         
