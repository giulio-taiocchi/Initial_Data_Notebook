Cell["\<\
Below I define the random factor that I will add to the profile of u1.\
\>", "Text",
 CellChangeTimes->{{3.939200891963593*^9, 3.939200962001829*^9}, {
  3.947567066581723*^9, 
  3.947567067009962*^9}},ExpressionUUID->"a960c187-1ff7-40e5-bad3-\
132622c19514"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"RandomFactor", "[", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "y_"}], "}"}], "]"}], "=", 
    RowBox[{"(*", 
     RowBox[{"Sum", "["}], "*)"}], 
    RowBox[{
     RowBox[{"RandomCoefficients1", "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"RandomModes1", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "x"}], "+", 
          RowBox[{
           RowBox[{"RandomModes1", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "y"}]}], ")"}], "2", " ", 
        RowBox[{"Pi", " ", "/", 
         RowBox[{"(", 
          RowBox[{"xMax", "-", "xMin"}], ")"}]}]}], "+", 
       RowBox[{"RandomOffsets1", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}]}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"+", 
        RowBox[{"RandomCoefficients1", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RandomModes2", "[", 
           RowBox[{"[", "i", "]"}], "]"}], 
          RowBox[{"(", 
           RowBox[{"i", "+", "1"}], ")"}], " ", "2", " ", "Pi", " ", 
          RowBox[{
           RowBox[{"(", "y", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", ",", "y"}], "}"}], ".", 
              RowBox[{"RandomDirections", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "*)"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"xMax", "-", "xMin"}], ")"}]}]}], "+", 
         RowBox[{"RandomOffsets2", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "modesTot"}], "}"}]}], "]"}], "*)"}], 
   ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"/;", 
     RowBox[{
      RowBox[{"x", "<", 
       FractionBox[
        RowBox[{"xMax", "-", "xMin"}], "2"]}], "&&", 
      RowBox[{"y", "<", 
       FractionBox[
        RowBox[{"yMax", "-", "yMin"}], "2"]}]}]}], ";", "\n", 
    RowBox[{
     RowBox[{"RandomFactor", "[", 
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}], "]"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Sum", "[", 
