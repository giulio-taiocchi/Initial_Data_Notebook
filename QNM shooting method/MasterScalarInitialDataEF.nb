Notebook[{

Cell[CellGroupData[{
Cell["\<\
Initial Conditions For Metric Perturbations From Master Scalars\
\>", "Chapter",
 CellChangeTimes->{{3.925212527288305*^9, 
  3.925212554862517*^9}},ExpressionUUID->"06afd957-7720-46d9-8b34-\
ae926cf1fd57"],

Cell[CellGroupData[{

Cell["\<\
Using the master scalar formulation of 1909.04049, we can solve the massless \
wave equation for a \[OpenCurlyDoubleQuote]master scalar\
\[CloseCurlyDoubleQuote] that is gauge invariant.
We then work backwards to the values of the metric perturbations, thereby \
providing initial data for Jecco nonlinear evolution\
\>", "Section",
 CellChangeTimes->{{3.9252125752474337`*^9, 3.925212755464558*^9}, {
  3.9253779577089424`*^9, 
  3.9253779850207243`*^9}},ExpressionUUID->"60a32385-c2c9-45b1-9b96-\
bddd1f8623c6"],

