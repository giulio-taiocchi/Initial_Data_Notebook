Cell[CellGroupData[{

Cell[TextData[StyleBox["Calculate the energy contained in the QNM", \
"Subsection"]], "Subsection",
 CellChangeTimes->{{3.9254720083161745`*^9, 3.9254720343867297`*^9}, {
   3.9255347134643755`*^9, 3.925534717976931*^9}, 
   3.9258162991799855`*^9},ExpressionUUID->"e23d2c74-b745-4d52-adb9-\
9a78747570d2"],

Cell[CellGroupData[{

Cell[TextData[{
 "Recall that the energy for a scalar field in Ingoing Eddington-Finklestein \
coordinates on an ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["AdS", "5"], TraditionalForm]],ExpressionUUID->
  "82a80df7-f515-40d7-80ea-a49d450ea7ef"],
 " black brane is\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], 
         RowBox[{"[", "\[Phi]", "]"}], "\[LongEqual]", 
         FractionBox["1", "2"], "\[Integral]", 
         StyleBox["d", "TI"], 
         SubscriptBox[
          StyleBox["r", "TI"], "*"], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
                RowBox[{
                  SubscriptBox["\[PartialD]", 
                   SubscriptBox[
                    StyleBox["r", "TI"], "*"]], "\[Phi]"}], ")"}], "2"], "+", 
             StyleBox["V", "TI"], 
             SuperscriptBox["\[Phi]", "2"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "$E[\\phi] = \\frac{1}{2} \\int dr_* \\left( (\\partial_{r_*} \\phi)^2 + \
V \\phi^2 \\right)$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "10ad92dd-0ca9-472f-8c21-db6baf5dfbbf"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["r", "TI"], "*"], TraditionalForm], "errors" -> {}, "input" -> 
     "$r_*$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0a930e33-c276-45e5-88a6-68a36f1695ab"],
 " is the tortoise coordinate is related to the compactified radial \
coordinate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["z", "TI"], "\[LongEqual]", "1", "/", 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$z=1/r$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "da753000-c722-459b-8f71-b93717fb345e"],
 " by\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], "*"], "\[LongEqual]", "\[Integral]", 
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["z", "TI"]}], 
          RowBox[{
            StyleBox["f", "TI"], "(", 
            StyleBox["z", "TI"], ")"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$r_* = \\int \\frac{dz}{f(z)}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b5ecdd57-1e6c-4db0-be34-cfba18b1b53e"],
 "\nTherefore, for a massless scalar field the energy is written as\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], 
         RowBox[{"[", "\[Phi]", "]"}], "\[LongEqual]", 
         FractionBox["1", "2"], "\[Integral] ", 
         StyleBox["f", "TI"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", 
               StyleBox["z", "TI"]], "\[Phi]"}], ")"}], "2"], 
         StyleBox["d", "TI"], 
         StyleBox["z", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$E[\\phi] = \\frac{1}{2} \\int \\, f (\\partial_z \\phi)^2 dz$", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "43372083-6373-4a7b-b5de-f70712b6a2c5"],
 "\nRecall that the master scalar in the tensor channel is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["z", "TI"], "2"], 
         SubscriptBox[
          StyleBox["h", "TI"], 
          RowBox[{
            StyleBox["x", "TI"], 
            StyleBox["y", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$z^2 h_{xy}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e66fcaf1-a411-43ba-a696-ad037ac08386"],
 ". Substituting this into ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], 
         RowBox[{"[", "\[Phi]", "]"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$E[\\phi]$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2a50434f-7689-4b08-9e00-68c0bebe1aae"],
 " gives the energy for the metric perturbation\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], 
         RowBox[{"[", 
           SubscriptBox[
            StyleBox["h", "TI"], 
            RowBox[{
              StyleBox["x", "TI"], 
              StyleBox["y", "TI"]}]], "]"}], "\[LongEqual]", 
         FractionBox["1", "2"], "\[Integral] ", 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           RowBox[{"4", 
             SuperscriptBox[
              StyleBox["z", "TI"], "2"], 
             SubsuperscriptBox[
              StyleBox["h", "TI"], 
              RowBox[{
                StyleBox["x", "TI"], 
                StyleBox["y", "TI"]}], "2"], "+", "4", 
             SuperscriptBox[
              StyleBox["z", "TI"], "3"], 
             SubscriptBox[
              StyleBox["h", "TI"], 
              RowBox[{
                StyleBox["x", "TI"], 
                StyleBox["y", "TI"]}]], 
             SubscriptBox["\[PartialD]", 
              StyleBox["z", "TI"]], 
             SubscriptBox[
              StyleBox["h", "TI"], 
              RowBox[{
                StyleBox["x", "TI"], 
                StyleBox["y", "TI"]}]], "+", 
             SuperscriptBox[
              StyleBox["z", "TI"], "4"], 
             SuperscriptBox[
              RowBox[{"(", 
                RowBox[{
                  SubscriptBox["\[PartialD]", 
                   StyleBox["z", "TI"]], 
                  SubscriptBox[
                   StyleBox["h", "TI"], 
                   RowBox[{
                    StyleBox["x", "TI"], 
                    StyleBox["y", "TI"]}]]}], ")"}], "2"]}], ")"}], 
         StyleBox["d", "TI"], 
         StyleBox["z", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "$E[h_{xy}]=\\frac{1}{2}\\int \\, f \\left( 4z^2 h^2_{xy} + 4 z^3 h_{xy} \
\\partial_z h_{xy} + z^4 (\\partial_z h_{xy})^2 \\right) dz$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3e237883-01b0-4a6c-9078-ed70a13e2644"]
}], "Subsubsection",
 CellChangeTimes->{{3.925816327628291*^9, 3.9258166175124254`*^9}, {
   3.925817009432453*^9, 3.925817015051859*^9}, {3.9258170528141546`*^9, 
