Cell[TextData[{
 "\[LineSeparator]Since we know that the metric component ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["h", "TI"], 
        RowBox[{
          StyleBox["x", "TI"], 
          StyleBox["y", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "$h_{xy}$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2f2cae7c-c481-4198-ae76-74ededcbb90a"],
 " comprises the tensor sector master scalar (see JHEP 09 (2002) 043), we can \
include a scalar function at that position in the metric and determine its \
QNM spectrum\nNote in the paper that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["h", "TI"], 
          RowBox[{
            StyleBox["x", "TI"], 
            StyleBox["y", "TI"]}]], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"2", "\[Pi]", 
              StyleBox["T", "TI"]}], ")"}], "2"], "\[Phi]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["t", "TI"], ",", 
             StyleBox["z", "TI"]}], ")"}], "/", 
         SuperscriptBox[
          StyleBox["z", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "$h_{xy} = (2\\pi T)^2 \\phi(t,z)/z^2$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "02e7d6e5-ef78-4b0d-8cc2-7f4fc47aed3d"],
 " is the master scalar"
}], "Text",
 CellChangeTimes->{{3.926491020109604*^9, 3.926491201629524*^9}, {
   3.926491303981893*^9, 3.9264913067434607`*^9}, 
   3.98714885822573*^9},ExpressionUUID->"e2012d87-5f48-4b6e-9cc6-\
5814988021ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"G", "=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["z", "2"]], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"f", "[", "z", "]"}]}], ",", 
        RowBox[{"-", "1"}], ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", " ", "0", ",", "0", ",", "0", ",", "0"}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "Pi", " ", "T"}], ")"}], "^", "2"}], " ", 
         RowBox[{
          RowBox[{"\[Phi]", " ", "[", 
           RowBox[{"t", ",", "z"}], "]"}], "/", " ", "2"}]}], ",", "0"}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"2", "Pi", " ", "T"}], ")"}], "^", "2"}], " ", 
         RowBox[{
          RowBox[{"\[Phi]", "[", 
           RowBox[{"t", ",", "z"}], "]"}], " ", "/", " ", "2"}]}], ",", "1", ",",
         " ", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "1"}], "}"}]}], 
     "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9264913259416428`*^9, 3.9264913692136245`*^9}, {
