Cell[BoxData[
 RowBox[{"(", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{"3", " ", "\[ImaginaryI]", " ", 
      SuperscriptBox["zh", "4"], " ", "\[Omega]"}], 
     RowBox[{"z", " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["z", "4"], "-", 
        SuperscriptBox["zh", "4"]}], ")"}]}]], " ", 
