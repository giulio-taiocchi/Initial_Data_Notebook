Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Integrand", "[", "z_", "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"z", "^", "4"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", " ", 
        RowBox[{"z", "^", "2"}], " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Abs", "[", 
           RowBox[{"hOut", "[", "z", "]"}], "]"}], ")"}], "^", "2"}]}], " ", "+", 
       RowBox[{"4", " ", 
        RowBox[{"z", "^", "3"}], " ", 
        RowBox[{"Abs", "[", 
         RowBox[{"hOut", "[", "z", "]"}], "]"}], " ", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", "1", "]"}], "[", "hOut", "]"}], "[", 
          "z", "]"}], "]"}]}], "+", " ", 
       RowBox[{
        RowBox[{"z", "^", "4"}], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", "1", "]"}], "[", "hOut", "]"}], "[", 
            "z", "]"}], "]"}], ")"}], "2"]}]}], " ", ")"}]}], "/.", 
    RowBox[{"result", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Energy", "=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", "2"}], ")"}], " ", 
     RowBox[{"Integrand", "[", "z", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"z", ",", "0", ",", "1"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9285708749834423`*^9, 3.928571004367627*^9}},
