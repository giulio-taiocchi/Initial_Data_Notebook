Cell[TextData[{
 "I define a tangent vector \[Xi] coming from ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "\[Mu]"]}], 
    RowBox[{"\[PartialD]", "\[Lambda]"}]], TraditionalForm]],ExpressionUUID->
  "cb571786-bd45-46b5-8fe8-3ed0e25b6e8d"],
 " (where in the parametrization ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "\[Mu]"], "=", "0"}], ",", "\[Lambda]", ",", "0", ",",
     "0", ",", "0"}], TraditionalForm]],ExpressionUUID->
  "f7362c47-fffc-4911-8361-c563140f8859"],
 ") and the surface element ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d\[CapitalSigma]", "\[Mu]"], "=", 
    RowBox[{
     SuperscriptBox["r", "2"], "dr", " ", 
     SubscriptBox["dx", "1"], 
     SubscriptBox["dx", "2"], 
     SubscriptBox["dx", "3"], 
     RowBox[{
      SubscriptBox["\[PartialD]", "\[Mu]"], "\[CapitalPhi]"}]}]}], 
   TraditionalForm]],ExpressionUUID->"8fc65a51-62dd-4a0a-bdc3-1b792805b18a"],
 ", where \[CapitalPhi] is the equation of the hypersurface \
\[CapitalPhi]=v-constant=0. So ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["d\[CapitalSigma]", "\[Mu]"], TraditionalForm]],
  ExpressionUUID->"d320c962-2e0c-4908-84bd-f11a31ac7582"],
 " is going to be in the direction of v. Then I convert  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", 
    FractionBox["1", "z"], " "}], TraditionalForm]],ExpressionUUID->
  "a6c5271c-6d80-4a52-b8ed-b2bebda3a27e"],
 "and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"dr", "=", 
    RowBox[{
     FractionBox[
      RowBox[{"-", "1"}], 
      SuperscriptBox["z", "2"]], "dz"}]}], TraditionalForm]],ExpressionUUID->
  "03a9646b-d3d4-4356-b34f-042f4a7e1cb7"]
}], "Text",
 CellChangeTimes->{{3.9388435914567537`*^9, 3.938843780802474*^9}, {
  3.93884381597689*^9, 
  3.938843889733027*^9}},ExpressionUUID->"17b8f256-d681-4d14-b460-\
2da9e8190ff1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Xi]u", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0", ",", "0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[CapitalSigma]u", "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{"-", "1"}], 
      SuperscriptBox["z", "4"]], 
     RowBox[{"IG", ".", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}]}]}], "/.", 
    RowBox[{"\[Epsilon]", "->", "0"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.938683977582539*^9, 3.938683986466331*^9}, {
  3.938684080663495*^9, 3.938684092603335*^9}, {3.938684138064272*^9, 
