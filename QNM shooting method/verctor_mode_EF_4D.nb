Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"htppRule", "=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"EinEq", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "3"}], "]"}], "]"}], "//", 
            RowBox[{
             RowBox[{"Series", "[", 
              RowBox[{"#", ",", 
               RowBox[{"{", 
                RowBox[{"\[Epsilon]", ",", "0", ",", "1"}], "}"}]}], "]"}], 
             "&"}]}], 
           RowBox[{"(*", 
            RowBox[{"//", "UpperTriangularize"}], "*)"}], "//", "Simplify"}], 
          "//", "Normal"}], "//", "Expand"}], ")"}], "==", "0"}], ",", 
