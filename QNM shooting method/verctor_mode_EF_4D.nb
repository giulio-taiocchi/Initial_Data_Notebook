Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Newton", "-", 
     RowBox[{"Raphson", " ", 
      RowBox[{"method", ":", 
       RowBox[{
       "at", " ", "every", " ", "step", " ", "it", " ", "changes", " ", "the",
         " ", "value", " ", "of", " ", "\[Phi]vev", " ", "and", " ", 
        "\[Omega]", " ", 
        RowBox[{"(", 
         RowBox[{
         "starting", " ", "from", " ", "an", " ", "initial", " ", "guess", " ",
           "that", " ", "we", " ", "give"}], ")"}], " ", "until", " ", "the", 
        " ", "integration", " ", "from", " ", "the", " ", "left", " ", "and", 
        " ", "the", " ", "integration", " ", "from", " ", "the", " ", "right",
         " ", "give", " ", "the", " ", "same", " ", "value", " ", "for", " ", 
        "the", " ", "field", " ", "and", " ", "its", " ", "derivative", " ", 
        "in", " ", "the", " ", "middle"}], ":", " ", 
       RowBox[{"\[Phi]", "[", "bound", "]"}]}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"\[Phi]", "'"}], "[", "bound", "]"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "GG", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"GG", "[", 
      RowBox[{"k_", ",", "midd_"}], "]"}], ":=", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"F2", "[", 
         RowBox[{
         "0", ",", "0", ",", "vty", ",", "\[Omega]", ",", " ", "k", ",", 
          "midd"}], "]"}], "\[Equal]", 
        RowBox[{"F1", "[", 
         RowBox[{"1", ",", "c2", ",", "\[Omega]", ",", "k", ",", "midd"}], 
         "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"c2", ",", "Tc2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"vty", ",", "Tvty"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Omega]", ",", "T\[Omega]"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "\[Rule]", "wp"}], ",", 
       RowBox[{"StepMonitor", "\[RuleDelayed]", 
        RowBox[{"Print", "[", 
         RowBox[{"Chop", "[", 
          RowBox[{
           RowBox[{"F2", "[", 
            RowBox[{
            "0", ",", "0", ",", "vty", ",", "\[Omega]", ",", "k", ",", 
             "midd"}], "]"}], "-", 
           RowBox[{"F1", "[", 
            RowBox[{"1", ",", "c2", ",", "\[Omega]", ",", "k", ",", "midd"}], 
            "]"}]}], "]"}], "]"}]}]}], "]"}]}], ";"}]}]}]], "Input",
