Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Extract", " ", "the", " ", "interpolation", " ", "data", " ", "points", " ",
     "from", " ", "f1", " ", "and", " ", "f2"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"datahtx1", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"z", ",", 
         RowBox[{
          RowBox[{"htx", "[", "z", "]"}], "/.", "sl2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", "small", ",", "bound", ",", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "choose", " ", "an", " ", "appropriate", " ", "step", " ", 
            "size"}], ",", 
           RowBox[{"e", ".", "g", "."}], ","}], "*)"}], "0.01"}], "}"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"datahtx2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"z", ",", 
         RowBox[{
          RowBox[{"htx", "[", "z", "]"}], "/.", "sl1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", 
         RowBox[{"bound", "+", "0.01"}], ",", 
         RowBox[{"1", "-", "smallIR"}], ",", "0.01"}], "}"}]}], "]"}]}], 
    ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"avoid", " ", "redundancy", " ", "at", " ", "z"}], "=", "b"}], 
    "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Combine", " ", "the", " ", "data", " ", "from", " ", "both", " ", 
     "interpolations"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"combinedDatahtx", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"datahtx1", ",", "datahtx2"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Create", " ", "a", " ", "new", " ", "interpolation", " ", "function", " ",
      "from", " ", "the", " ", "combined", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"htxFunction2", "[", "z_", "]"}], "=", 
     RowBox[{"Interpolation", "[", "combinedDatahtx", "]"}]}], ";"}], 
   "\n"}]}]], "Input",
