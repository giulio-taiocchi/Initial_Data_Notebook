Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"New", " ", "grid"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"NPoints2", "=", "200"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xValues2", "=", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"b", ",", "a", ",", 
        FractionBox[
         RowBox[{"a", " ", "2"}], "NPoints2"]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", 
        RowBox[{"-", "2"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yValues2", "=", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"b", ",", "a", ",", 
        FractionBox[
         RowBox[{"a", " ", "2"}], "NPoints2"]}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", 
        RowBox[{"-", "2"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MyGrid2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"uValues", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "u"}], "]"}], "]"}], ",", 
         RowBox[{"xValues2", "[", 
