         RowBox[{"uValues", "//", "Length"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "1", ",", 
         RowBox[{
          RowBox[{"uValues", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "//", "Length"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "1", ",", 
         RowBox[{"xValues2", "//", "Length"}]}], "}"}], ",", 
