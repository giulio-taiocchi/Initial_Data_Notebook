      "<>", "\"\<NBB_gaussian_Lx60000_Ly10000_\>\"", 
      "<>", "\"\<3d3iu10_6d6u010_Nx450_Ny75_u0d3_\>\"", 
      "<>", "\"\<tzero50000_tau20000_A0d8_s0d5_dt0d219_\>\"", 
      "<>", "\"\<recovery\>\""}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Create", " ", "main", " ", "recovery", " ", "directory"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CreateDirectory", "[", 
     RowBox[{"recoveryBaseDir", ",", 
      RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"GET", " ", "CHECKPOINT", " ", "FILES"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"files", "=", 
     RowBox[{"FileNames", "[", 
      RowBox[{"\"\<checkpoint_it*.h5\>\"", ",", "checkpointDir"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"files", "=", 
     RowBox[{"Sort", "[", "files", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Found \>\"", ",", 
      RowBox[{"Length", "[", "files", "]"}], 
      ",", "\"\< checkpoint files\>\""}], "]"}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "CREATE", " ", "ONE", " ", "RECOVERY", " ", "FOLDER", " ", "PER", " ", 
     "CHECKPOINT"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "==="}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"file", "=", 
       RowBox[{"files", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"base", "=", 
       RowBox[{"FileBaseName", "[", "file", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"iter", "=", 
       RowBox[{
        RowBox[{"StringCases", "[", 
         RowBox[{"base", ",", 
          RowBox[{
           RowBox[{"\"\<checkpoint_it\>\"", "~~", 
            RowBox[{"x", ":", "NumberString"}]}], ":>", "x"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"recoverDir", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"recoveryBaseDir", ",", 
          RowBox[{"\"\<recover_\>\"", "<>", "iter"}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Create", " ", "recovery", " ", "folder"}], "*)"}], 
      RowBox[{"CreateDirectory", "[", 
       RowBox[{"recoverDir", ",", 
        RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Create", " ", "symbolic", " ", "link", " ", "to", " ", "checkpoint"}],
        "*)"}], 
      RowBox[{"Run", "[", 
       RowBox[{"\"\<ln -sf \>\"", "<>", "file", "<>", "\"\< \>\"", "<>", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"recoverDir", ",", 
           
           RowBox[{"\"\<checkpoint_it\>\"", "<>", "iter", 
            "<>", "\"\<.h5\>\""}]}], "}"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Created: \>\"", ",", "recoverDir"}], "]"}], ";"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "files", "]"}]}], "}"}]}], "]"}], "\n", "\[IndentingNewLine]", 
