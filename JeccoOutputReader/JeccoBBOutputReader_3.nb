 RowBox[{
  RowBox[{"fxFitVec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"A", " ", 
       RowBox[{"E", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "wi"}], 
          RowBox[{"(", 
           RowBox[{"Timess", "[", 
            RowBox[{"[", "t", "]"}], "]"}], ")"}]}], ")"}]}]}], "/.", 
      RowBox[{"fxFit", "[", "\"\<BestFitParameters\>\"", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "1", ",", 
       RowBox[{"Timess", 
        RowBox[{"(*", 
         RowBox[{"[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "100"}], "]"}], "]"}], "*)"}], "//", 
        "Length"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fxFitVecLog", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"A", "+", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "  ", "wi"}], 
         RowBox[{"(", 
          RowBox[{"Timess", "[", 
           RowBox[{"[", "t", "]"}], "]"}], ")"}]}], ")"}]}], "/.", 
      RowBox[{"fxFit", "[", "\"\<BestFitParameters\>\"", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "1", ",", 
       RowBox[{"Timess", 
        RowBox[{"(*", 
         RowBox[{"[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", "100"}], "]"}], "]"}], "*)"}], "//", 
        "Length"}]}], "}"}]}], "]"}]}], ";"}]}], "Input",
