Cell[CellGroupData[{

Cell["getEquationsAtOrder", "Section",
 CellChangeTimes->{
  3.7516155528386517`*^9},ExpressionUUID->"3faa6def-b4a8-4f3c-bf1a-\
6f10e5b226e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"getEquationsAtOrder", "[", 
   RowBox[{"order_", ",", "logorder_", ",", "logorderIncreased_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"Not", "@", 
     RowBox[{"TrueQ", "[", "logorderIncreased", "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"getSeriesCoeff", "[", 
        RowBox[{"eqAsymptotic", ",", "order", ",", "logorder"}], "]"}], "/.", 
       
       RowBox[{
        RowBox[{
         SubscriptBox["f_", 
          RowBox[{"n_", ",", "l_"}]], "/;", 
         RowBox[{"l", ">", "logorder"}]}], "\[Rule]", 
        RowBox[{"(", 
         RowBox[{"0", "&"}], ")"}]}]}], "/.", "replnbBCs"}], "//", "Expand"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"ord", "\[Function]", 
        RowBox[{"Expand", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"getSeriesCoeff", "[", 
            RowBox[{"eqAsymptotic", ",", "ord", ",", "logorder"}], "]"}], "/.", 
           RowBox[{
            RowBox[{
             SubscriptBox["f_", 
              RowBox[{"n_", ",", "l_"}]], "/;", 
             RowBox[{"l", ">", "logorder"}]}], "\[Rule]", 
            RowBox[{"(", 
             RowBox[{"0", "&"}], ")"}]}]}], "/.", "replnbBCs"}], "]"}]}], 
       ")"}], "/@", 
