           RowBox[{"(", 
            RowBox[{
             RowBox[{"replfcts", "\[LeftDoubleBracket]", 
              RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}], "/.", 
             "replfcts"}], ")"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
        "allfctsdotfin"}], "]"}], "\[LeftDoubleBracket]", "1", 
      "\[RightDoubleBracket]"}], "/.", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a_", "[", "X", "]"}], "\[Rule]", "b_"}], ")"}], 
      "\[RuleDelayed]", 
      RowBox[{"(", 
       RowBox[{"a", "\[Rule]", 
        RowBox[{"function", "[", 
         RowBox[{
          RowBox[{"{", "X", "}"}], ",", 
          RowBox[{"Collect", "[", 
           RowBox[{"b", ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", 
              RowBox[{"Log", "[", 
               RowBox[{"1", "/", "r"}], "]"}]}], "}"}], ",", "Simplify"}], 
           "]"}]}], "]"}]}], ")"}]}]}], "/.", 
