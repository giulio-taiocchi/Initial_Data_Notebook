Cell[CellGroupData[{

Cell["Rewrite coordinate r to u=1/r", "Subchapter",
 CellChangeTimes->{{3.748779216025056*^9, 3.748779220554471*^9}, 
   3.750503025766788*^9},ExpressionUUID->"3d867593-ba79-49a3-a8c4-\
