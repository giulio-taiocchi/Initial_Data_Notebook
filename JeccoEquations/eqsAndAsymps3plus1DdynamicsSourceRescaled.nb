Cell[CellGroupData[{

Cell["Bulk equation: Solve_nested, outer_coefficient", "Subsection",
 CellChangeTimes->{{3.908951170340341*^9, 3.908951252207217*^9}, {
  3.908951717840802*^9, 3.908951721141477*^9}, {3.910261265086206*^9, 
  3.910261273613472*^9}, {3.910262747163629*^9, 
  3.9102627478733673`*^9}},ExpressionUUID->"5a6d5a9b-af0a-45fb-9050-\
afcf82cba20a"],

Cell["\<\
We want to compute the coefficients for the ODE of the nested system. We will \
put each of this equation in the file equation_inner_coefficient. The \
coefficients, from there, will be called in the file solve_nested, where a \
function solve_x is called for all the x variables in the nested system. \
These solve_x are called in the function solve_nested (same name as the file \
solve_nested.jl).\
\>", "Text",
 CellChangeTimes->{{3.908951529331761*^9, 3.9089515298493423`*^9}, {
  3.908951713058536*^9, 
  3.908951896354748*^9}},ExpressionUUID->"6f52da4c-008c-4212-9cc2-\
6a02d714fce9"],

Cell["\<\
! ! ! invert the order between rewrite spatial derivative and replfcts!!!\
\>", "Text",
 CellChangeTimes->{{3.9095769407873*^9, 
  3.909576966471962*^9}},ExpressionUUID->"dd10a4fa-7f0b-48cf-a5b6-\
a674208a5751"],

