Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"replfcts", "[", 
          RowBox[{"[", 
           RowBox[{"8", ",", "2", ",", "2"}], "]"}], "]"}], "//", "rtou"}], 
        ")"}], "==", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[PartialD]", "t"], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"replfcts", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2", ",", "2"}], "]"}], "]"}], "//", "rtou"}], 
          ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"replfcts", "[", 
               RowBox[{"[", 
                RowBox[{"9", ",", "2", ",", "2"}], "]"}], "]"}], "//", 
              "rtou"}], ")"}], 
            RowBox[{"(*", 
             RowBox[{
              SuperscriptBox["r", "2"], "+", 
              FractionBox[
               RowBox[{"Afin", "[", 
                RowBox[{"t", ",", "r", ",", "z", ",", "y"}], "]"}], "r"], "+", 
              RowBox[{"2", " ", "r", " ", 
               RowBox[{"\[Xi]", "[", 
                RowBox[{"t", ",", "z", ",", "y"}], "]"}]}], "+", 
              SuperscriptBox[
               RowBox[{"\[Xi]", "[", 
                RowBox[{"t", ",", "z", ",", "y"}], "]"}], "2"], "-", 
              RowBox[{"2", " ", 
               RowBox[{
                SuperscriptBox["\[Xi]", 
                 TagBox[
                  RowBox[{"(", 
                   RowBox[{"1", ",", "0", ",", "0"}], ")"}],
                  Derivative],
                 MultilineFunction->None], "[", 
                RowBox[{"t", ",", "z", ",", "y"}], "]"}]}]}], "*)"}]}], "2"], 
          ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
