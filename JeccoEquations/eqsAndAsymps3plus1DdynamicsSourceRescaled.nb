 CellChangeTimes->{{3.7559294939252977`*^9, 
  3.7559295000818863`*^9}},ExpressionUUID->"0165d2c6-1fc2-482e-ab21-\
ad2dff7b46c9"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"checkNested", "[", 
    RowBox[{"eqs_", ",", "initfuncts_", ",", "solfuncts_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"functsKnown", "=", 
        RowBox[{"{", "initfuncts", "}"}]}], ",", "unknownFuncts"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"unknownFuncts", "=", 
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"Union", "@", 
             RowBox[{"Cases", "[", 
              RowBox[{
               RowBox[{"eqs", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Derivative", "[", "___", "]"}], "[", "f_", "]"}],
                    "[", "X", "]"}], "|", 
                  RowBox[{"f_", "[", "X", "]"}]}], ")"}], "\[RuleDelayed]", 
                "f"}], ",", "\[Infinity]"}], "]"}]}], ",", 
            RowBox[{"Flatten", "@", "functsKnown"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"functsKnown", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"functsKnown", ",", 
            RowBox[{"{", "unknownFuncts", "}"}]}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "eqs", "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "functsKnown"}]}], "\[IndentingNewLine]", 
    "]"}]}], "*)"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.751514101153761*^9, 3.751514295850008*^9}, 
