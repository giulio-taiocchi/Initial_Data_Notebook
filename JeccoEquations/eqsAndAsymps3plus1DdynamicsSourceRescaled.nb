Cell[CellGroupData[{

Cell["find best variables", "Subsection",
 CellChangeTimes->{{3.751624675250046*^9, 3.75162467860499*^9}, {
  3.7516266163343763`*^9, 
  3.7516266166706333`*^9}},ExpressionUUID->"690f7b03-4cf0-4f4b-997d-\
a8a6b1566437"],

Cell[BoxData[
 RowBox[{
  RowBox[{"findBestVariables", "[", 
   RowBox[{"order_", ",", "eq_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"allvars", "=", 
       RowBox[{"Union", "@", 
        RowBox[{"Cases", "[", 
         RowBox[{"eq", ",", 
          RowBox[{
           SubscriptBox["f_", 
            RowBox[{"n_", ",", "l_"}]], "[", "Xbdry", "]"}], ",", 
          "\[Infinity]"}], "]"}]}]}], ",", "bestvars", ",", 
      RowBox[{"specialVars", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"derivativeModes", ",", 
         RowBox[{
