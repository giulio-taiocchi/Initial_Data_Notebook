375aae51a685"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "logord", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fctToRule", "=", 
   RowBox[{"(", 
    RowBox[{"f", "\[Function]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"tof0", "[", "f", "]"}], "\[Rule]", 
       RowBox[{"sum", "[", 
        RowBox[{
         RowBox[{"sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             SubscriptBox[
              RowBox[{"ToExpression", "[", 
               RowBox[{
                RowBox[{"ToString", "[", "f", "]"}], "<>", "\"\<c\>\""}], 
               "]"}], 
              RowBox[{"n", ",", "m"}]], "[", "Xbdry", "]"}], " ", 
            SuperscriptBox["r", 
             RowBox[{"-", "n"}]], 
            SuperscriptBox[
             RowBox[{"Log", "[", "r", "]"}], "m"]}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "0", ",", "ord"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "0", ",", "logord"}], "}"}]}], "]"}]}], ")"}]}], 
    ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"replRules", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"fctToRule", "/@", 
         RowBox[{"Join", "[", "functs0", "]"}]}], ")"}], "/.", 
       RowBox[{"Rule", "\[Rule]", "RuleDelayed"}]}], "/.", 
      RowBox[{"sum", "\[Rule]", "Sum"}]}], "/.", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"f_", "\[RuleDelayed]", "frepl_"}], ")"}], "\[RuleDelayed]", 
      RowBox[{"(", 
       RowBox[{"f", "\[Rule]", 
        RowBox[{"Function", "[", 
         RowBox[{"arg", ",", "frepl"}], "]"}]}], ")"}]}]}], "/.", 
    RowBox[{"arg$", "\[Rule]", 
     RowBox[{"{", "X", "}"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"replnb", "[", 
   RowBox[{"ord_", ",", "logord_"}], "]"}], "=", 
  "replRules"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"replnb", "[", "ord_", "]"}], ":=", 
  RowBox[{"replnb", "[", 
   RowBox[{"ord", ",", "0"}], "]"}]}]}], "Input",
