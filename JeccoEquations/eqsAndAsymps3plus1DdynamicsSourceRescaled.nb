                  RowBox[{
                   SuperscriptBox["\[Xi]", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"1", ",", "0", ",", "0"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", 
