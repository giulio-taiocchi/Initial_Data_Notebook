Cell[BoxData[
 RowBox[{
  RowBox[{"replinv", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Solve", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", "X", "]"}], "&"}], ")"}], "/@", 
           RowBox[{"replfcts", "\[LeftDoubleBracket]", 
            RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}]}], 
          "\[Equal]", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
