24c6fdcd3dd4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"makeNice", "[", "expr_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"expr", "/.", 
     RowBox[{"dot", "\[Rule]", "OverDot"}]}], "/.", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"f_", "[", "X", "]"}], "|", 
       RowBox[{"f_", "[", "Xu", "]"}]}], ")"}], "\[RuleDelayed]", "f"}]}], "/.", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      SuperscriptBox["f_", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"0", ",", "dr_", ",", 
          RowBox[{
           RowBox[{"(", "0", ")"}], "..."}]}], ")"}],
        Derivative],
       MultilineFunction->None], "\[RuleDelayed]", 
      SuperscriptBox["f", 
       TagBox[
        RowBox[{"(", "dr", ")"}],
        Derivative],
       MultilineFunction->None]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      SuperscriptBox["f_", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"0", ",", "dr_", ",", "dz_", ",", 
          RowBox[{
           RowBox[{"(", "0", ")"}], "..."}]}], ")"}],
        Derivative],
       MultilineFunction->None], "\[RuleDelayed]", 
      SubscriptBox[
       SuperscriptBox["f", 
        TagBox[
         RowBox[{"(", "dr", ")"}],
         Derivative],
        MultilineFunction->None], 
       RowBox[{"StringJoin", "@@", 
        RowBox[{"Table", "[", 
         RowBox[{"\"\<z\>\"", ",", 
          RowBox[{"{", "dz", "}"}]}], "]"}]}]]}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      SuperscriptBox["f_", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"0", ",", "dr_", ",", "dz_", ",", 
          RowBox[{
           RowBox[{"dy_", 
            RowBox[{"(", "0", ")"}]}], "..."}]}], ")"}],
        Derivative],
       MultilineFunction->None], "\[RuleDelayed]", 
      SubscriptBox[
       SuperscriptBox["f", 
        TagBox[
         RowBox[{"(", "dr", ")"}],
         Derivative],
        MultilineFunction->None], 
       RowBox[{"StringJoin", "@@", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{"\"\<z\>\"", ",", 
            RowBox[{"{", "dz", "}"}]}], "]"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{"\"\<y\>\"", ",", 
            RowBox[{"{", "dy", "}"}]}], "]"}]}], "]"}]}]]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      SuperscriptBox["f_", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"0", ",", "dr_", ",", "dz_", ",", "dy_", ",", "dx_", ",", 
          RowBox[{
           RowBox[{"(", "0", ")"}], "..."}]}], ")"}],
        Derivative],
       MultilineFunction->None], "\[RuleDelayed]", 
      SubscriptBox[
       SuperscriptBox["f", 
        TagBox[
         RowBox[{"(", "dr", ")"}],
         Derivative],
        MultilineFunction->None], 
       RowBox[{"StringJoin", "@@", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{"\"\<z\>\"", ",", 
            RowBox[{"{", "dz", "}"}]}], "]"}], ",", 
          RowBox[{"Table", "[", 
