        RowBox[{"{", 
         RowBox[{"r", ",", "2"}], "}"}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Sfinp", "[", 
       RowBox[{"t", ",", "r", ",", "z", ",", "y"}], "]"}], "->", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"Sfin", "[", 
         RowBox[{"t", ",", "r", ",", "z", ",", "y"}], "]"}], ",", "r"}], 
       "]"}]}]}], "}"}]}], ";"}]], "Input",
