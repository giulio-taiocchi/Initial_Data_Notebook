  RowBox[{"allfctsdot", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", "X", "]"}], "&"}], "/@", 
    RowBox[{"(", 
     RowBox[{"functs", "/.", "dottodot"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
