Cell[CellGroupData[{

Cell["for nDynamical >=4, make symbolic at this stage", "Subsubsection",
 CellChangeTimes->{{3.755591480709598*^9, 
  3.75559149418652*^9}},ExpressionUUID->"0c4d6c0e-d9e9-4491-ba41-\
80e302ed7779"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"nDynamical", "\[GreaterEqual]", "4"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"gIN", "\[LeftDoubleBracket]", 
         RowBox[{
          RowBox[{"2", "+", "i"}], ",", 
          RowBox[{"2", "+", "j"}]}], "\[RightDoubleBracket]"}], "=", 
        RowBox[{
         SubscriptBox["G", 
          RowBox[{"i", ",", "j"}]], "[", "X", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"dval", "-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"dval", "-", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gIN", "=", 
      RowBox[{
       RowBox[{"gIN", "/.", 
        RowBox[{
         RowBox[{
          SubscriptBox["G", 
           RowBox[{"i_", ",", "j_"}]], "/;", 
          RowBox[{"i", ">", "j"}]}], "\[RuleDelayed]", 
         SubscriptBox["G", 
          RowBox[{"j", ",", "i"}]]}]}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           SubscriptBox["G", 
            RowBox[{"i_", ",", "j_"}]], "/;", 
           RowBox[{
            RowBox[{"j", ">", 
             RowBox[{"nDynamical", "-", "2"}]}], "&&", 
            RowBox[{"i", "=!=", "j"}]}]}], "\[Rule]", 
          RowBox[{"(", 
           RowBox[{"0", "&"}], ")"}]}], ",", 
         RowBox[{
          RowBox[{
           SubscriptBox["G", 
            RowBox[{"i_", ",", "j_"}]], "/;", 
           RowBox[{
            RowBox[{"j", "\[GreaterEqual]", 
             RowBox[{"nDynamical", "-", "1"}]}], "&&", 
            RowBox[{"i", "==", "j"}]}]}], "\[Rule]", 
          SubscriptBox["G", 
           RowBox[{
            RowBox[{"nDynamical", "-", "1"}], ",", 
            RowBox[{"nDynamical", "-", "1"}]}]]}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gSpatialSolve", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"DSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"S", "[", "X", "]"}], "2"], "gINspatial"}], "]"}], 
             "\[Equal]", 
             RowBox[{"Flatten", "[", 
              RowBox[{"gIN", "\[LeftDoubleBracket]", 
               RowBox[{
                RowBox[{"3", ";;", "All"}], ",", 
                RowBox[{"3", ";;", "All"}]}], "\[RightDoubleBracket]"}], 
              "]"}]}], "]"}], "//", 
           RowBox[{
            RowBox[{"DeleteCases", "[", 
             RowBox[{"#", ",", "True"}], "]"}], "&"}]}], ",", 
          RowBox[{"Evaluate", "@", 
           RowBox[{"Flatten", "@", 
            RowBox[{"Table", "[", 
             RowBox[{
