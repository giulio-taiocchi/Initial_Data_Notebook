   3.751480468581695*^9}},ExpressionUUID->"c9b18405-424e-468b-b164-\
7793b1e180bf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dottodot", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"f_", "/;", 
       RowBox[{"StringMatchQ", "[", 
        RowBox[{
         RowBox[{"ToString", "@", "f"}], ",", "\"\<*dotdot\>\""}], "]"}]}], 
      "\[RuleDelayed]", 
      RowBox[{"dot", "[", 
       RowBox[{"dot", "[", 
        RowBox[{"ToExpression", "[", 
         RowBox[{"StringTake", "[", 
          RowBox[{
           RowBox[{"ToString", "@", "f"}], ",", 
           RowBox[{"1", ";;", 
            RowBox[{"-", "7"}]}]}], "]"}], "]"}], "]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"f_", "/;", 
       RowBox[{"StringMatchQ", "[", 
        RowBox[{
         RowBox[{"ToString", "@", "f"}], ",", "\"\<*dot\>\""}], "]"}]}], 
      "\[RuleDelayed]", 
      RowBox[{"dot", "[", 
       RowBox[{"ToExpression", "[", 
        RowBox[{"StringTake", "[", 
         RowBox[{
          RowBox[{"ToString", "@", "f"}], ",", 
          RowBox[{"1", ";;", 
           RowBox[{"-", "4"}]}]}], "]"}], "]"}], "]"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allfcts", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", "X", "]"}], "&"}], "/@", "functs"}], ")"}], "/.", 
     "dottodot"}], "//.", "dottodt"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.647068080454809*^9, 3.6470681261823463`*^9}, {
