 RowBox[{
  RowBox[{
   RowBox[{"check", "[", "True", "]"}], "=", "True"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"check", "[", "trues_", "]"}], "/;", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"And", "@@", "trues"}], "===", "True"}], ")"}]}], ":=", 
   "trues"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"check", "[", "nottrue_", "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"errorCount", "++"}], ";", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Beep", "[", "]"}], ";", 
       RowBox[{"Pause", "[", ".2", "]"}], ";"}], ",", 
      RowBox[{"{", "4", "}"}]}], "]"}], ";", 
    RowBox[{"Style", "[", 
     RowBox[{"nottrue", ",", 
      RowBox[{"{", 
       RowBox[{"Large", ",", "Red"}], "}"}]}], "]"}]}], ")"}]}]}], "Input",
