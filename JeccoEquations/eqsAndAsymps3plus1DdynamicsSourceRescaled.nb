Cell[CellGroupData[{

Cell["variable change code", "Section",
 CellChangeTimes->{{3.6566622915530863`*^9, 3.6566622925051003`*^9}, {
  3.6619306834124823`*^9, 
  3.661930686886819*^9}},ExpressionUUID->"d4ea1c69-bc2e-457d-8aec-\
d89eff376073"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Xu", "=", 
   RowBox[{"Sequence", "@@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", "X", "}"}], "/.", 
      RowBox[{"r", "\[Rule]", "u"}]}], ")"}]}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.750503149921788*^9, 3.7505031694203243`*^9}},
 CellLabel->
  "In[244]:=",ExpressionUUID->"4c880619-eb78-4400-8160-a01acdcfd282"],

Cell["\<\
This does any variable change, where relation is rNew as a function of rOld.\
\>", "Text",
 CellChangeTimes->{{3.656662293548531*^9, 
  3.656662324183208*^9}},ExpressionUUID->"9dd35e05-e9a4-440f-876b-\
9b114503f76e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"transformCoord", "[", 
    RowBox[{"rOld_", ",", "rNew_", ",", "relation_"}], "]"}], "[", "expr_", 
   "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"oldtonew", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"rNew", "\[Equal]", "relation"}], ",", "rOld"}], "]"}], "//", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"FreeQ", "[", 
              RowBox[{"#", ",", 
               RowBox[{"Times", "[", 
                RowBox[{
                 RowBox[{"-", "1"}], ",", "___"}], "]"}]}], "]"}], "&&", 
             RowBox[{"FreeQ", "[", 
              RowBox[{"#", ",", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "_"]}], "]"}]}], "&"}]}], "]"}], 
         "&"}]}], "//", "Last"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"expr", "/.", 
       RowBox[{
        RowBox[{
         SuperscriptBox["f_", 
          TagBox[
           RowBox[{"(", 
            RowBox[{"dt_", ",", "dr_", ",", "drest___"}], ")"}],
           Derivative],
          MultilineFunction->None], "[", 
         RowBox[{"t", ",", "rOld", ",", "Xspatial"}], "]"}], "\[RuleDelayed]", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"Nest", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 SubscriptBox["\[PartialD]", "rOld"], "relation"}], "/.", 
                "oldtonew"}], ")"}], 
              RowBox[{
               SubscriptBox["\[PartialD]", "rNew"], "#1"}]}], "&"}], ",", 
            RowBox[{"f", "[", 
             RowBox[{"t", ",", "rNew", ",", "Xspatial"}], "]"}], ",", "dr"}], 
           "]"}], ",", 
          RowBox[{"Sequence", "@@", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", "Xbdry", "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"dt", ",", "drest"}], "}"}]}], "}"}], "]"}]}]}], 
         "]"}]}]}], "/.", " ", 
      RowBox[{
       RowBox[{"f_", "[", 
        RowBox[{"t", ",", "rOld", ",", "Xspatial"}], "]"}], "\[RuleDelayed]", 
       
       RowBox[{"f", "[", 
        RowBox[{"t", ",", "rNew", ",", "Xspatial"}], "]"}]}]}], "/.", 
     "oldtonew"}]}], "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.656660132912058*^9, 3.656660160245406*^9}, {
   3.656660193579121*^9, 3.65666025004128*^9}, {3.656660664916419*^9, 
   3.656660676953031*^9}, {3.656660723499114*^9, 3.656660746103425*^9}, {
   3.656662374893516*^9, 3.656662376278989*^9}, {3.658930405660399*^9, 
   3.658930436754345*^9}, {3.659339846099744*^9, 3.6593398514555273`*^9}, 
   3.66098020579532*^9, {3.750503188443407*^9, 3.7505032101131907`*^9}, {
   3.751008816160486*^9, 3.7510088513911037`*^9}, {3.7510090517838287`*^9, 
   3.7510090574578648`*^9}, {3.751009088467107*^9, 3.751009161887134*^9}, {
   3.751009268711256*^9, 3.7510092985406113`*^9}},
 CellLabel->
  "In[245]:=",ExpressionUUID->"892b7497-8c84-4a40-8cec-062ee5e17980"]
}, Open  ]],

Cell[CellGroupData[{

Cell["replacement rules in u coordinate", "Section",
 CellChangeTimes->{{3.657878823761692*^9, 3.6578788242450333`*^9}, {
   3.748779562830467*^9, 3.748779570906302*^9}, 
   3.75050332687711*^9},ExpressionUUID->"c3923a6e-cd03-4660-85eb-\
c834e0d0571c"],

Cell[TextData[{
 "To keep only integer powers (as long as z, \[CapitalDelta] are integer), we \
transform to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"u", "=", 
    FractionBox["1", "r"]}], TraditionalForm]],ExpressionUUID->
  "06c69749-bf3e-468b-aa88-c50c371be611"],
 " where r is the original one, in the metric with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "dt", " ", "dr"}], TraditionalForm]],ExpressionUUID->
  "6e898688-0d04-4e8b-b5c2-fca42db4356f"],
 "."
}], "Text",
 CellChangeTimes->{{3.6578786652154007`*^9, 3.65787870099824*^9}, {
  3.740472476177796*^9, 3.740472476177864*^9}, {3.750503331020172*^9, 
  3.750503331020233*^9}},ExpressionUUID->"b6700b0e-2f7c-4980-85c7-\
f96a8098e745"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rtou", "=", 
   RowBox[{"transformCoord", "[", 
    RowBox[{"r", ",", "u", ",", 
     SuperscriptBox["r", 
      RowBox[{"-", "1"}]]}], "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellLabel->
  "In[246]:=",ExpressionUUID->"e9b8f360-cec2-4a54-a9cf-a5ab756782b5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"replfctsu", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"replfcts", "/.", 
      RowBox[{"Function", "\[Rule]", "function"}]}], "/.", 
     RowBox[{
      RowBox[{"function", "[", 
       RowBox[{
        RowBox[{"{", "X", "}"}], ",", "expr_"}], "]"}], "\[RuleDelayed]", 
      RowBox[{"function", "[", 
       RowBox[{
        RowBox[{"{", "Xu", "}"}], ",", 
        RowBox[{
         RowBox[{"expr", "/.", 
          RowBox[{"r", "\[Rule]", 
           SuperscriptBox["u", 
            RowBox[{"-", "1"}]]}]}], "/.", 
         RowBox[{
          RowBox[{"f_", "[", 
           RowBox[{"t", ",", 
            SuperscriptBox["u", 
             RowBox[{"-", "1"}]], ",", "Xspatial"}], "]"}], "\[RuleDelayed]", 
          
          RowBox[{"f", "[", 
           RowBox[{"t", ",", "u", ",", "Xspatial"}], "]"}]}]}]}], "]"}]}]}], "/.", 
    RowBox[{"function", "\[Rule]", "Function"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"replfctsuinv", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"replinv", "/.", 
      RowBox[{"Function", "\[Rule]", "function"}]}], "/.", 
     RowBox[{
      RowBox[{"function", "[", 
       RowBox[{
        RowBox[{"{", "X", "}"}], ",", "expr_"}], "]"}], "\[RuleDelayed]", 
      RowBox[{"function", "[", 
       RowBox[{
        RowBox[{"{", "Xu", "}"}], ",", 
        RowBox[{
         RowBox[{"expr", "/.", 
          RowBox[{"r", "\[Rule]", 
           SuperscriptBox["u", 
            RowBox[{"-", "1"}]]}]}], "/.", 
         RowBox[{
          RowBox[{"f_", "[", 
           RowBox[{"t", ",", 
            SuperscriptBox["u", 
             RowBox[{"-", "1"}]], ",", "Xspatial"}], "]"}], "\[RuleDelayed]", 
          
          RowBox[{"f", "[", 
           RowBox[{"t", ",", "u", ",", "Xspatial"}], "]"}]}]}]}], "]"}]}]}], "/.", 
    RowBox[{"function", "\[Rule]", "Function"}]}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.740478152069302*^9, 3.740478164801827*^9}, {
  3.74047829487409*^9, 3.740478334766577*^9}, {3.7505032154509*^9, 
