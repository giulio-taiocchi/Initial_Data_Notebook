Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalLambda]", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "d"}], 
     RowBox[{"(", 
      RowBox[{"d", "-", "1"}], ")"}]}], "/.", 
    RowBox[{"d", "\[Rule]", "dval"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"einst0", "=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"RddSimp", "-", 
         RowBox[{
          FractionBox["1", "2"], "R", " ", "gdd"}], " ", "+", 
         RowBox[{
          FractionBox["1", "2"], "gdd", " ", "\[CapitalLambda]"}]}], " ", 
        RowBox[{"(*", " ", 
         RowBox[{"pure", " ", "AdS"}], " ", "*)"}], " ", 
        "\[IndentingNewLine]", "/.", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"a_", " ", ":", " ", "0"}], ")"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"c_", " ", ":", " ", "1"}], ")"}], " ", 
            RowBox[{"G", "[", "X", "]"}]}]}], "]"}], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"Exp", "[", "a", "]"}], " ", 
          RowBox[{"ExpToTrig", "[", 
           RowBox[{"Exp", "[", 
            RowBox[{"c", " ", 
             RowBox[{"G", "[", "X", "]"}]}], "]"}], "]"}]}]}]}], "//", 
       "UpperTriangularize"}], "//", 
      RowBox[{
       RowBox[{"Collect", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cosh", "[", "_", "]"}], ",", 
           RowBox[{"Sinh", "[", "_", "]"}], ",", 
           RowBox[{"Exp", "[", "_", "]"}], ",", 
           RowBox[{"S", "[", "X", "]"}]}], "}"}], ",", "Simplify"}], "]"}], 
       "&"}]}], ")"}]}], ";"}], "//", 
  "AbsoluteTiming"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"einst", "=", 
   RowBox[{"einst0", "+", 
    RowBox[{"Transpose", "[", "einst0", "]"}], "-", 
    RowBox[{"DiagonalMatrix", "@", 
     RowBox[{"Diagonal", "[", "einst0", "]"}]}]}]}], ";"}]}], "Input",
 InitializationCell->True,
