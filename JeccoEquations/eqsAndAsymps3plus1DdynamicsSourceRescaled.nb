Cell[BoxData[{
 RowBox[{
  RowBox[{"dotfactor", "=", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"gdd", "\[LeftDoubleBracket]", 
      RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}], 
     RowBox[{"gdd", "\[LeftDoubleBracket]", 
      RowBox[{"1", ",", "2"}], "\[RightDoubleBracket]"}]]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dttodot", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["f_", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"dt_", ",", "drest___"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", "X", "]"}], "/;", 
      RowBox[{"dt", "\[GreaterEqual]", " ", "1"}]}], "\[RuleDelayed]", 
     RowBox[{
      RowBox[{"myD", "[", 
       RowBox[{
        RowBox[{"dt", "-", "1"}], ",", "drest"}], "]"}], "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dot", "[", "f", "]"}], "[", "X", "]"}], "-", 
       RowBox[{
        FractionBox["1", "2"], "dotfactor", 
        RowBox[{
         SubscriptBox["\[PartialD]", "r"], 
         RowBox[{"f", "[", "X", "]"}]}]}]}], "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dottodt", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"dot", "[", "f_", "]"}], "[", "X", "]"}], "\[RuleDelayed]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[PartialD]", "t"], 
         RowBox[{"f", "[", "X", "]"}]}], "+", 
        RowBox[{
         FractionBox["1", "2"], " ", "dotfactor", " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", "r"], 
          RowBox[{"f", "[", "X", "]"}]}]}]}], ")"}]}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"dot", "[", "f_", "]"}], 
        TagBox[
         RowBox[{"(", 
          RowBox[{"dt_", ",", "drest___"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", "X", "]"}], "\[RuleDelayed]", 
      RowBox[{
       RowBox[{"myD", "[", 
        RowBox[{"dt", ",", "drest"}], "]"}], "[", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[PartialD]", "t"], 
         RowBox[{"f", "[", "X", "]"}]}], "+", 
        RowBox[{
         FractionBox["1", "2"], "dotfactor", " ", 
         RowBox[{
          SubscriptBox["\[PartialD]", "r"], 
          RowBox[{"f", "[", "X", "]"}]}]}]}], "]"}]}]}], "}"}]}], 
  ";"}]}], "Input",
