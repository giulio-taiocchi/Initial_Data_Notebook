Cell[CellGroupData[{

Cell["checkOrderSolved", "Section",
 CellChangeTimes->{
  3.751790816738625*^9},ExpressionUUID->"09795bc5-b5cf-4198-ae57-\
519581b69855"],

Cell[BoxData[
 RowBox[{
  RowBox[{"checkOrderSolved", "[", "sols_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"sols", "=!=", "$Failed"}], ",", "\[IndentingNewLine]", 
    RowBox[{"thisOrderSolved", "=", "True"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{"logorderIncreased", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"TemplateApply", "[", 
          RowBox[{
          "\"\<Failed at order `1`, increasing log order to `2` didn't help, \
something is wrong...\>\"", ",", 
           RowBox[{"{", 
            RowBox[{"order", ",", "logorder"}], "}"}]}], "]"}], "]"}], ";", 
        RowBox[{"Return", "[", 
         RowBox[{"$Failed", ",", "Block"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"logorder", "===", "logordMax"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{"TemplateApply", "[", 
            RowBox[{
            "\"\<Failed at order `1`, maximum log order `2` already reached, \
this should be enough...\>\"", ",", 
             RowBox[{"{", 
              RowBox[{"order", ",", "logorder"}], "}"}]}], "]"}], "]"}], ";", 
          
          RowBox[{"Return", "[", 
           RowBox[{"$Failed", ",", "Block"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"logorder", "+=", "1"}], ";", "\[IndentingNewLine]", " ", 
          RowBox[{"logorderIncreased", "=", "True"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"holdTagSet", "[", 
                RowBox[{"#", ",", 
                 RowBox[{
                  SubscriptBox["#", 
                   RowBox[{"n_", ",", "logorder"}]], "/;", 
                  RowBox[{"n", "<", "holdord"}]}], ",", 
                 RowBox[{"(", 
                  RowBox[{"0", "&"}], ")"}]}], "]"}], "&"}], "/@", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"ToExpression", "[", 
                  RowBox[{
                   RowBox[{"ToString", "[", "#", "]"}], "<>", "\"\<c\>\""}], 
                  "]"}], "&"}], "/@", "functs0"}], ")"}]}], ")"}], "/.", 
            RowBox[{"holdord", "\[Rule]", "order"}]}], "/.", 
           RowBox[{"holdTagSet", "\[Rule]", "TagSet"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"subactivity", "=", "\"\<\>\""}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"TemplateApply", "[", 
            RowBox[{
            "\"\<Failed at order `1`, increasing log order to `2` and trying \
again\>\"", ",", 
             RowBox[{"{", 
              RowBox[{"order", ",", "logorder"}], "}"}]}], "]"}], "]"}]}]}], 
        "\[IndentingNewLine]", "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]",
    "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.7517854556523037`*^9, 3.751785458526219*^9}, {
  3.7517855202255087`*^9, 3.751785544479694*^9}, {3.751792336375476*^9, 
