13dab38ae94e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"check", "[", "expr_", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tmp", "=", 
      RowBox[{
       RowBox[{"Union", "@", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", "expr", "}"}], "]"}]}], "//", "Quiet"}]}], "}"}], ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"tmp", "===", 
        RowBox[{"{", "True", "}"}]}], "||", 
       RowBox[{"tmp", "===", 
        RowBox[{"{", "0", "}"}]}]}], ",", "True", ",", "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Beep", "[", "]"}], ";", " ", 
          RowBox[{"Pause", "[", ".25", "]"}]}], ",", 
         RowBox[{"{", "4", "}"}]}], "]"}], ";", 
       RowBox[{"Style", "[", 
        RowBox[{"expr", ",", 
         RowBox[{"{", 
          RowBox[{"Large", ",", "Red"}], "}"}]}], "]"}]}]}], "]"}]}], 
   "]"}]}]], "Input",
 InitializationCell->True,
