           RowBox[{"1", "/", "r"}], "]"}]}], "}"}], ",", "fff"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fff", "[", "eqn_", "]"}], "\[RuleDelayed]", 
       RowBox[{"eqn", "\[Equal]", "0"}]}], ",", "Infinity"}], "]"}], "//", 
    "simplifyEquations"}], "//", "sortEquations"}]}]], "Input",
