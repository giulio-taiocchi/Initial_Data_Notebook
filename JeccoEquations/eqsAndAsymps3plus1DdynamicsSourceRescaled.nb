88c09cecc1b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"solNested", "=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#", "\[Equal]", "0"}], "&"}], "/@", "eqsNested"}], ",", 
      "functsNested"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.7556044928357067`*^9, 3.755604512357409*^9}},
 CellLabel->
