Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"myD", "[", "nrs__", "]"}], "[", "expr_", "]"}], ":=", 
  RowBox[{"D", "[", 
   RowBox[{"expr", ",", 
    RowBox[{"Sequence", "@@", 
     RowBox[{"(", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"xINdynamical", ",", 
         RowBox[{"{", "nrs", "}"}]}], "}"}], "]"}], ")"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"myDbdry", "[", "nrs__", "]"}], "[", "expr_", "]"}], ":=", 
  RowBox[{"D", "[", 
   RowBox[{"expr", ",", 
    RowBox[{"Sequence", "@@", 
     RowBox[{"(", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "Xbdry", "}"}], ",", 
         RowBox[{"{", "nrs", "}"}]}], "}"}], "]"}], ")"}]}]}], 
   "]"}]}]}], "Input",
 InitializationCell->True,
