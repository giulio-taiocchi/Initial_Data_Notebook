Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"eomdotFinite0", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"eomdot", "/.", 
       RowBox[{"Equal", "\[Rule]", "Subtract"}]}], "//", "rtou"}], "//", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "/.", "replfctsu"}], "/.", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"1", "/", "u"}], "]"}], "\[Rule]", 
        RowBox[{"-", 
         RowBox[{"Log", "[", "u", "]"}]}]}]}], "&"}]}]}], 
   RowBox[{"(*", 
    RowBox[{"//", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#", ",", 
        RowBox[{"{", 
         RowBox[{"u", ",", 
          RowBox[{"Log", "[", "u", "]"}], ",", 
          RowBox[{"_", "[", "X", "]"}]}], "}"}]}], "]"}], "&"}]}], "*)"}], 
   ";"}], "//", "AbsoluteTiming"}]], "Input",
 InitializationCell->True,
