Cell[BoxData[
 RowBox[{
  RowBox[{"findBestVariables", "[", 
   RowBox[{"order_", ",", "eq_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"allvars", "=", 
       RowBox[{"Union", "@", 
        RowBox[{"Cases", "[", 
         RowBox[{"eq", ",", 
          RowBox[{
           SubscriptBox["f_", 
            RowBox[{"n_", ",", "l_"}]], "[", "Xbdry", "]"}], ",", 
          "\[Infinity]"}], "]"}]}]}], ",", "bestvars", ",", 
      RowBox[{"specialVars", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"derivativeModes", ",", 
         RowBox[{
          RowBox[{"Not", "@", 
           RowBox[{"FreeQ", "[", 
            RowBox[{"eq", ",", "#"}], "]"}]}], "&"}]}], "]"}]}]}], 
     RowBox[{"(*", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"Union", "@", 
         RowBox[{"Cases", "[", 
          RowBox[{"eq", ",", 
           RowBox[{
            RowBox[{
             SubscriptBox["\[PartialD]", "t"], 
             RowBox[{"f_", "[", "Xbdry", "]"}]}], "/;", 
            RowBox[{
             RowBox[{"Head", "[", "f", "]"}], "=!=", "Subscript"}]}], ",", 
           "\[Infinity]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           SubscriptBox["\[PartialD]", "t"], 
           RowBox[{"\[Phi]vev", "[", "Xbdry", "]"}]}], ",", 
          RowBox[{
           SubscriptBox["\[PartialD]", "t"], 
           RowBox[{"\[ScriptCapitalP]", "[", "Xbdry", "]"}]}], ",", 
          RowBox[{
           SubscriptBox["\[PartialD]", "t"], 
           RowBox[{"\[ScriptCapitalP]2", "[", "Xbdry", "]"}]}], ",", 
          RowBox[{
           SubscriptBox["\[PartialD]", "t"], 
           RowBox[{"J", "[", "Xbdry", "]"}]}], ",", 
          RowBox[{
           SubscriptBox["\[PartialD]", "t"], 
           RowBox[{"\[Xi]", "[", "Xbdry", "]"}]}]}], "}"}]}], "]"}], "*)"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"bestvars", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Cases", "[", 
         RowBox[{"allvars", ",", 
          RowBox[{
           RowBox[{
            SubscriptBox["f_", 
             RowBox[{"n_", ",", "l_"}]], "[", "Xbdry", "]"}], "/;", 
           RowBox[{"(", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"FreeQ", "[", 
              RowBox[{"eq", ",", 
               RowBox[{
                SuperscriptBox[
                 SubscriptBox["f", 
                  RowBox[{"n", ",", "l"}]], 
                 TagBox[
                  RowBox[{"(", "__", ")"}],
                  Derivative],
                 MultilineFunction->None], "[", "Xbdry", "]"}]}], "]"}], "&&",
              "\[IndentingNewLine]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"FreeQ", "[", 
                RowBox[{"eq", ",", 
                 SuperscriptBox[
                  RowBox[{
                   SubscriptBox["f", 
                    RowBox[{"n", ",", "l"}]], "[", "Xbdry", "]"}], "m_"]}], 
                "]"}], "||", 
               RowBox[{
                RowBox[{"Head", "[", 
                 RowBox[{"eq", "/.", "\[VeryThinSpace]", 
                  RowBox[{
                   RowBox[{"a_", "\[Equal]", "b_"}], "\[RuleDelayed]", 
                   RowBox[{"Expand", "[", 
                    RowBox[{"a", "-", "b"}], "]"}]}]}], "]"}], "=!=", 
                "Plus"}]}], ")"}]}], "\[IndentingNewLine]", ")"}]}]}], "]"}], 
        ",", "specialVars"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"bestvars", ",", 
       RowBox[{"Complement", "[", 
        RowBox[{"allvars", ",", "bestvars"}], "]"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
