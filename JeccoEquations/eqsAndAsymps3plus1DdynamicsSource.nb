          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"t", ",", "r", ",", "z", ",", "y"}], "]"}], "/;", 
       RowBox[{"dr", "==", "1"}]}], "\[RuleDelayed]", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"ToExpression", "[", 
         RowBox[{
          RowBox[{"ToString", "[", "f", "]"}], "<>", "\"\<p\>\""}], "]"}], 
