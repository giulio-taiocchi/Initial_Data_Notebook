  3.751859378826542*^9}},ExpressionUUID->"67003ca3-71df-4cf6-af43-\
e1eee1924ce0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eomsolvarsNormal", "=", 
   RowBox[{"First", "/@", 
    RowBox[{"First", "/@", 
     RowBox[{
      RowBox[{"MaximalBy", "[", "Last", "]"}], "/@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"{", "#", "}"}], ",", 
           RowBox[{
            RowBox[{
             SuperscriptBox["f_", 
              TagBox[
               RowBox[{"(", 
                RowBox[{"dt_", ",", "drest___"}], ")"}],
               Derivative],
              MultilineFunction->None], "[", "X", "]"}], "\[RuleDelayed]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               SuperscriptBox["f", 
                TagBox[
                 RowBox[{"(", 
                  RowBox[{"dt", ",", "drest"}], ")"}],
                 Derivative],
                MultilineFunction->None], "[", "X", "]"}], ",", "dt"}], 
             "}"}]}], ",", "\[Infinity]"}], "]"}], "&"}], "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"functsNested", "//.", 
           RowBox[{"restoreSpatialDerivatives", "[", "]"}]}], "//.", 
          "dottodt"}], ")"}]}], ")"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solutionsNormal", "=", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{"#1", ",", "#2"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"solNested", "//.", 
          RowBox[{"restoreSpatialDerivatives", "[", "]"}]}], "//.", 
         "dottodt"}], "/.", 
        RowBox[{"Rule", "\[Rule]", "Equal"}]}], ",", "eomsolvarsNormal"}], 
      "}"}]}], "]"}]}], 
  RowBox[{"(*", 
   RowBox[{"//", "Simplify"}], "*)"}], ";"}]}], "Input",
 InitializationCell->True,
