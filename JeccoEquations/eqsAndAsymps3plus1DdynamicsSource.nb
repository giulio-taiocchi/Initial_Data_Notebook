 RowBox[{"(*", 
  RowBox[{"Arepl", "=", 
   RowBox[{"A", "\[Rule]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"{", "X", "}"}], "~", "function", "~", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"A\[Xi]", "[", "X", "]"}], "+", 
         RowBox[{"2", "r", "  ", 
