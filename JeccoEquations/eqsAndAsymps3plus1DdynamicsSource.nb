Cell["\<\
ftof0 rules send the variables to their relative f0 multiplied by r to the \
leading factor.\
\>", "Text",
 CellChangeTimes->{{3.914319519009131*^9, 
  3.914319581651403*^9}},ExpressionUUID->"732aba1f-e64b-451b-9647-\
50a0e399c80c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ftof0", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "\[Rule]", 
        RowBox[{"function", "[", 
         RowBox[{
          RowBox[{"{", "X", "}"}], ",", 
          RowBox[{
           SuperscriptBox["r", 
            RowBox[{"leading", "[", "#", "]"}]], 
           RowBox[{
            RowBox[{"tof0", "[", "#", "]"}], "[", "X", "]"}]}]}], "]"}]}], 
       "&"}], "/@", "functs0"}], ")"}], "/.", 
    RowBox[{"function", "\[Rule]", "Function"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eom", "=", 
   RowBox[{
    RowBox[{"eomdot", "//.", "dottodt"}], "/.", 
    RowBox[{"Equal", "\[Rule]", "Subtract"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eomf0", "=", 
   RowBox[{"eom", "/.", "ftof0"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.750679973207904*^9, 3.750679985632327*^9}, {
