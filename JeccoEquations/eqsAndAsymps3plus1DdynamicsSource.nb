Cell[BoxData[
 RowBox[{
  RowBox[{"SSThetaEq", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[CapitalTheta]eqSpDer", "//", 
             RowBox[{
              RowBox[{"Collect", "[", 
               RowBox[{"#", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   SuperscriptBox["\[Xi]", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"1", ",", "2", ",", "0"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", 
                   RowBox[{"t", ",", "z", ",", "y"}], "]"}], ",", 
                  RowBox[{
                   SuperscriptBox["\[Xi]", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"1", ",", "0", ",", "2"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", 
                   RowBox[{"t", ",", "z", ",", "y"}], "]"}], ",", 
                  RowBox[{
                   SuperscriptBox["\[Xi]", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"1", ",", "1", ",", "1"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", 
                   RowBox[{"t", ",", "z", ",", "y"}], "]"}], ",", 
                  RowBox[{
                   SuperscriptBox["\[Xi]", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"1", ",", "1", ",", "0"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", 
                   RowBox[{"t", ",", "z", ",", "y"}], "]"}], ",", 
                  RowBox[{
                   SuperscriptBox["\[Xi]", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"1", ",", "0", ",", "1"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", 
                   RowBox[{"t", ",", "z", ",", "y"}], "]"}], ",", 
                  RowBox[{
                   SuperscriptBox["\[Xi]", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"1", ",", "0", ",", "0"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", 
                   RowBox[{"t", ",", "z", ",", "y"}], "]"}], ",", 
                  RowBox[{
                   SuperscriptBox["\[Xi]", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"0", ",", "2", ",", "1"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", 
                   RowBox[{"t", ",", "z", ",", "y"}], "]"}], ",", 
                  RowBox[{
                   SuperscriptBox["\[Xi]", 
                    TagBox[
                    RowBox[{"(", 
                    RowBox[{"0", ",", "1", ",", "2"}], ")"}],
                    Derivative],
                    MultilineFunction->None], "[", 
                   RowBox[{"t", ",", "z", ",", "y"}], "]"}], ",", 
                  RowBox[{"F\[Xi]d", "[", 
                   RowBox[{"t", ",", "u", ",", "z", ",", "y"}], "]"}], ",", ",", 
                  RowBox[{"F2\[Xi]d", "[", 
                   RowBox[{"t", ",", "u", ",", "z", ",", "y"}], "]"}]}], 
                 "}"}]}], "]"}], "&"}]}], ")"}], "/.", 
           RowBox[{
            RowBox[{"F2\[Xi]d", "[", 
             RowBox[{"t", ",", "u", ",", "z", ",", "y"}], "]"}], "->", 
            "0"}]}], "/.", 
          RowBox[{
           RowBox[{"F\[Xi]d", "[", 
            RowBox[{"t", ",", "u", ",", "z", ",", "y"}], "]"}], "->", "0"}]}],
          "/.", 
         RowBox[{
          RowBox[{
           SuperscriptBox["\[Xi]", 
            TagBox[
             RowBox[{"(", 
              RowBox[{"1", ",", "2", ",", "0"}], ")"}],
             Derivative],
            MultilineFunction->None], "[", 
           RowBox[{"t", ",", "z", ",", "y"}], "]"}], "->", "0"}]}], "/.", 
        RowBox[{
         RowBox[{
          SuperscriptBox["\[Xi]", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"1", ",", "0", ",", "2"}], ")"}],
            Derivative],
           MultilineFunction->None], "[", 
          RowBox[{"t", ",", "z", ",", "y"}], "]"}], "->", "0"}]}], "/.", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Xi]", 
          TagBox[
           RowBox[{"(", 
            RowBox[{"1", ",", "1", ",", "1"}], ")"}],
           Derivative],
          MultilineFunction->None], "[", 
