        MultilineFunction->None], "[", "X", "]"}], "/;", 
      RowBox[{"dt", "\[GreaterEqual]", " ", "1"}]}], "\[RuleDelayed]", 
     RowBox[{
      RowBox[{"myD", "[", 
       RowBox[{
        RowBox[{"dt", "-", "1"}], ",", "drest"}], "]"}], "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dot", "[", "f", "]"}], "[", "X", "]"}], "-", 
       RowBox[{
