Cell[CellGroupData[{

Cell["solveSingleEqAtGivenOrder", "Subsection",
 CellChangeTimes->{
  3.7516176902131147`*^9},ExpressionUUID->"587d7a19-3021-490c-9ab4-\
a74655cb2a53"],

Cell[BoxData[
 RowBox[{
  RowBox[{"solveSingleEqAtGivenOrder", "[", 
   RowBox[{"order_", ",", "eq_", ",", "solutionAtThisOrder_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"equation", "=", 
       RowBox[{"eq", "/.", "solutionAtThisOrder"}]}], ",", "goodvariables", ",",
       "badvariables", ",", "sol"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"equation", "===", "True"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"goodvariables", ",", "badvariables"}], "}"}], "=", 
      RowBox[{"findBestVariables", "[", 
       RowBox[{"order", ",", "equation"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"goodvariables", "=!=", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"Quiet", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{"equation", ",", "goodvariables"}], "]"}], "\[LeftDoubleBracket]",
            "1", "\[RightDoubleBracket]"}], ",", 
          RowBox[{"Solve", "::", "svars"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<no good variables for eq: \>\"", ",", "equation"}], 
          "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"badvariables", "=!=", 
           RowBox[{"{", "}"}]}], "&&", 
          RowBox[{"Quiet", "[", 
           RowBox[{"sol", "===", 
            RowBox[{
             RowBox[{"{", "}"}], "\[LeftDoubleBracket]", "1", 
             "\[RightDoubleBracket]"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"sol", "=", 
          RowBox[{"Quiet", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Solve", "[", 
              RowBox[{"equation", ",", "badvariables"}], "]"}], "\[LeftDoubleBracket]",
              "1", "\[RightDoubleBracket]"}], ",", 
            RowBox[{"Solve", "::", "svars"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Return", "[", 
          RowBox[{"Quiet", "[", 
           RowBox[{
            RowBox[{"{", "}"}], "\[LeftDoubleBracket]", "1", 
            "\[RightDoubleBracket]"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
        "]"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Quiet", "[", 
         RowBox[{"sol", "===", 
          RowBox[{
           RowBox[{"{", "}"}], "\[LeftDoubleBracket]", "1", 
           "\[RightDoubleBracket]"}]}], "]"}], "&&", 
        RowBox[{"goodvariables", "=!=", 
         RowBox[{"{", "}"}]}], "&&", 
        RowBox[{"badvariables", "=!=", 
         RowBox[{"{", "}"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Couldn't solve with good variables\>\"", ",", 
          "goodvariables", ",", "\"\<, now trying with bad variables\>\"", ",",
           "badvariables", ",", "\"\<sol: \>\"", ",", "sol", 
          ",", "\"\<eq: \>\"", ",", "eq"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"Quiet", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Solve", "[", 
             RowBox[{"equation", ",", "badvariables"}], "]"}], "\[LeftDoubleBracket]",
             "1", "\[RightDoubleBracket]"}], ",", 
           RowBox[{"Solve", "::", "svars"}]}], "]"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"sol", "//", "formatSolution"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.751617691058777*^9, 3.7516176934680157`*^9}, {
