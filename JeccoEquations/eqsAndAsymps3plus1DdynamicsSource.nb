         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"t", ",", "r", ",", "z", ",", "y"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Sp", "[", 
       RowBox[{"t", ",", "r", ",", "z", ",", "y"}], "]"}], "\[Rule]", 
