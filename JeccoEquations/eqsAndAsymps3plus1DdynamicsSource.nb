Cell[BoxData[
 RowBox[{
  RowBox[{"makeEquations", "[", "expr_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Cases", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", 
          RowBox[{"Log", "[", 
           RowBox[{"1", "/", "r"}], "]"}]}], "}"}], ",", "fff"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"fff", "[", "eqn_", "]"}], "\[RuleDelayed]", 
       RowBox[{"eqn", "\[Equal]", "0"}]}], ",", "Infinity"}], "]"}], "//", 
    "simplifyEquations"}], "//", "sortEquations"}]}]], "Input",
 InitializationCell->True,
