Cell["the inverse", "Text",
 CellChangeTimes->{{3.63747839895341*^9, 3.637478399804043*^9}, {
  3.637482234283744*^9, 3.637482234883947*^9}, {3.652441390053644*^9, 
  3.652441390581505*^9}},ExpressionUUID->"12f377cd-01ca-4bb7-a209-\
0abcdad3c449"],

Cell[BoxData[
 RowBox[{
  RowBox[{"replinv", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Solve", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", "X", "]"}], "&"}], ")"}], "/@", 
           RowBox[{"replfcts", "\[LeftDoubleBracket]", 
            RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}]}], "\[Equal]", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", "X", "]"}], "&"}], ")"}], "/@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"replfcts", "\[LeftDoubleBracket]", 
              RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}], "/.", 
             "replfcts"}], ")"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
        "allfctsdotfin"}], "]"}], "\[LeftDoubleBracket]", "1", 
      "\[RightDoubleBracket]"}], "/.", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"a_", "[", "X", "]"}], "\[Rule]", "b_"}], ")"}], "\[RuleDelayed]", 
      RowBox[{"(", 
       RowBox[{"a", "\[Rule]", 
        RowBox[{"function", "[", 
         RowBox[{
          RowBox[{"{", "X", "}"}], ",", 
          RowBox[{"Collect", "[", 
           RowBox[{"b", ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", 
              RowBox[{"Log", "[", 
               RowBox[{"1", "/", "r"}], "]"}]}], "}"}], ",", "Simplify"}], 
           "]"}]}], "]"}]}], ")"}]}]}], "/.", 
    RowBox[{"function", "\[Rule]", "Function"}]}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.637478401434334*^9, 3.637478432195677*^9}, {
