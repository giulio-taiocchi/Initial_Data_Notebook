Cell[BoxData[
 RowBox[{
  RowBox[{"simplifyWithRule", "[", 
   RowBox[{"expr_", ",", "rules_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"names", "=", 
      RowBox[{"rules", "\[LeftDoubleBracket]", 
       RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"And", "@@", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"FreeQ", "[", 
           RowBox[{"expr", ",", "#"}], "]"}], "&"}], "/@", "names"}], ")"}]}],
       ",", "expr", ",", 
      RowBox[{
       RowBox[{"expr", "/.", "rules"}], "//", "simplifyEquations"}]}], 
     "]"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
