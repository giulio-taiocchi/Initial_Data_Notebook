Cell[BoxData[
 RowBox[{
  RowBox[{"solveNBeqsAtGivenOrder", "[", 
   RowBox[{"order_", ",", "eqs_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"sortedEquations", ",", "solutionOfThisEquation", ",", 
      RowBox[{"solutionAtThisOrder", "=", 
       RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"subactivity", "=", "\"\<sortEquations\>\""}], ";", 
     RowBox[{"sortedEquations", "=", 
      RowBox[{"makeEquations", "[", "eqs", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"sortedEquations", "=!=", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"subactivity", "=", 
         RowBox[{"\"\<solveSingleEqAtGivenOrder, equations remaining: \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"Length", "[", "sortedEquations", "]"}], "]"}]}]}], ";", 
        RowBox[{"Quiet", "[", 
         RowBox[{
          RowBox[{"solutionOfThisEquation", "=", 
           RowBox[{"solveSingleEqAtGivenOrder", "[", 
            RowBox[{"order", ",", 
             RowBox[{"First", "@", "sortedEquations"}], ",", 
             "solutionAtThisOrder"}], "]"}]}], ",", 
          RowBox[{"Part", "::", "partw"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"Quiet", "[", 
           RowBox[{"solutionOfThisEquation", "=!=", 
            RowBox[{
             RowBox[{"{", "}"}], "\[LeftDoubleBracket]", "1", 
             "\[RightDoubleBracket]"}]}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"solutionAtThisOrder", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"solutionAtThisOrder", ",", "solutionOfThisEquation"}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"sortedEquations", "=", 
            RowBox[{
             RowBox[{"simplifyWithRule", "[", 
              RowBox[{
               RowBox[{"Rest", "[", "sortedEquations", "]"}], ",", 
               "solutionAtThisOrder"}], "]"}], "//", 
             RowBox[{
              RowBox[{"Sort", "[", 
               RowBox[{"#", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"LeafCount", "[", "#1", "]"}], "<", 
                  RowBox[{"LeafCount", "[", "#2", "]"}]}], "&"}]}], "]"}], 
              "&"}]}]}], ";"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", 
           RowBox[{"$Failed", ",", "Block"}], "]"}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "solutionAtThisOrder"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
