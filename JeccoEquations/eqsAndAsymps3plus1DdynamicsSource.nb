     RowBox[{"dot", "\[Rule]", "OverDot"}]}], "/.", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"f_", "[", "X", "]"}], "|", 
       RowBox[{"f_", "[", "Xu", "]"}]}], ")"}], "\[RuleDelayed]", "f"}]}], "/.", 
   RowBox[{"{", "\[IndentingNewLine]", 
