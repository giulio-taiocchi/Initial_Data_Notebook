Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"checkNested", "[", 
    RowBox[{"eqs_", ",", "initfuncts_", ",", "solfuncts_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"functsKnown", "=", 
        RowBox[{"{", "initfuncts", "}"}]}], ",", "unknownFuncts"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"unknownFuncts", "=", 
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"Union", "@", 
             RowBox[{"Cases", "[", 
              RowBox[{
               RowBox[{"eqs", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Derivative", "[", "___", "]"}], "[", "f_", "]"}],
                    "[", "X", "]"}], "|", 
                  RowBox[{"f_", "[", "X", "]"}]}], ")"}], "\[RuleDelayed]", 
                "f"}], ",", "\[Infinity]"}], "]"}]}], ",", 
            RowBox[{"Flatten", "@", "functsKnown"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"functsKnown", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"functsKnown", ",", 
            RowBox[{"{", "unknownFuncts", "}"}]}], "]"}]}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "eqs", "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "functsKnown"}]}], "\[IndentingNewLine]", 
    "]"}]}], "*)"}]], "Input",
