 RowBox[{
  RowBox[{"dttodot", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["f_", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"dt_", ",", "drest___"}], ")"}],
