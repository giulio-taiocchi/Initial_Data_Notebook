   RowBox[{"eqs", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SubscriptBox["f_", 
        RowBox[{"n_", ",", "l_"}]], "[", "Xbdry", "]"}], ",", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["f_", 
         RowBox[{"n_", ",", "l_"}]], 
        TagBox[
         RowBox[{"(", "___", ")"}],
         Derivative],
        MultilineFunction->None], "[", "Xbdry", "]"}]}], "}"}], ",", 
    "Expand"}], "]"}]}]], "Input",
