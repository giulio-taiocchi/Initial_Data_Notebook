d699a6aa3c9b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"findLeading", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "x0_", ",", "startingPower_"}], "}"}], "]"}], "[", 
   "expr_", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"power", "=", "startingPower"}], ",", 
      RowBox[{"test", "=", "True"}], ",", "series"}], "}"}], ",", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{"test", ",", 
       RowBox[{
        RowBox[{"series", "=", 
         RowBox[{"Series", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "x0", ",", "power"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"power", "++"}], ";", 
        RowBox[{"test", "=", 
         RowBox[{"TrueQ", "[", 
          RowBox[{
           RowBox[{
           "series", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "\[Equal]", 
           RowBox[{"{", "}"}]}], "]"}]}], ";"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"power", "-", "1"}], "]"}], ")"}], "*)"}], 
     "\[IndentingNewLine]", 
