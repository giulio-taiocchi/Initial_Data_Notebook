Cell[CellGroupData[{

Cell["Solve near boundary expansion, code", "Subchapter",
 CellChangeTimes->{{3.751613586240087*^9, 3.751613586404945*^9}, {
  3.751615557472604*^9, 3.7516155618561087`*^9}, {3.751616587519271*^9, 
  3.7516165882254477`*^9}},ExpressionUUID->"ff6374c0-b543-4b68-8cff-\
2279457ac8da"],

Cell[BoxData[
 RowBox[{
  RowBox[{"solveNBnew", "[", "maxorder_", "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"thisOrderSolved", ",", 
      RowBox[{"logorder", "=", "0"}], ",", "logorderIncreased", ",", 
      RowBox[{"activity", "=", "\"\<\>\""}], ",", 
      RowBox[{"subactivity", "=", "\"\<\>\""}], ",", "time"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"solsNB", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Monitor", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"activity", "=", "\"\<\>\""}], ";", 
           RowBox[{"subactivity", "=", "\"\<\>\""}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"logorderIncreased", "=", "False"}], ";", 
           RowBox[{"thisOrderSolved", "=", "False"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"time", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"While", "[", 
                 RowBox[{
                  RowBox[{"Not", "@", "thisOrderSolved"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"activity", "=", "\"\<getEquationsAtOrder\>\""}], ";", 
                   RowBox[{"subactivity", "=", "\"\<\>\""}], ";", 
                   RowBox[{
                    SubscriptBox["eqs", "order"], "=", 
                    RowBox[{"getEquationsAtOrder", "[", 
                    RowBox[{
                    "order", ",", "logorder", ",", "logorderIncreased"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", 
                   RowBox[{"activity", "=", "\"\<inserting solutions\>\""}], ";", 
                   RowBox[{
                    SubscriptBox["eqs", "order"], "=", 
                    RowBox[{
                    SubscriptBox["eqs", "order"], "//.", "solsNB"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                   "activity", "=", "\"\<solveNBeqsAtGivenOrder\>\""}], ";", 
                   RowBox[{
                    SubscriptBox["sols", "order"], "=", 
                    RowBox[{"solveNBeqsAtGivenOrder", "[", 
                    RowBox[{"order", ",", 
                    SubscriptBox["eqs", "order"]}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"activity", "=", "\"\<checkOrderSolved\>\""}], ";", 
                   RowBox[{"checkOrderSolved", "[", 
                    SubscriptBox["sols", "order"], "]"}], ";"}]}], 
                 "\[IndentingNewLine]", "]"}], ";"}], ")"}], "//", 
              "AbsoluteTiming"}], "//", "First"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"activity", "=", "\"\<combineSolutions\>\""}], ";", 
           RowBox[{"solsNB", "=", 
            RowBox[{"combineSolutions", "[", 
             RowBox[{"solsNB", ",", 
              SubscriptBox["sols", "order"]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"\"\<Found at order \>\"", "<>", 
              RowBox[{"ToString", "[", "order", "]"}], "<>", "\"\<: \>\""}], ",",
              " ", 
             RowBox[{
              SubscriptBox["sols", "order"], "\[LeftDoubleBracket]", 
              RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}], ",", 
             RowBox[{"\"\< (\>\"", "<>", 
              RowBox[{"ToString", "[", 
               RowBox[{"N", "[", 
                RowBox[{"time", ",", "4"}], "]"}], "]"}], 
              "<>", "\"\<s).\>\""}]}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"order", ",", "0", ",", "maxorder"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"processNBsolutions", "[", "solsNB", "]"}], ";", 
        "\[IndentingNewLine]", "solsNB"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"activity", ",", "subactivity"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.751616179963099*^9, 3.7516162440992203`*^9}, {
   3.751616281165235*^9, 3.7516164429287777`*^9}, {3.751616536293083*^9, 
