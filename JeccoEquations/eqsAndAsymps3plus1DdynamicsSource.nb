   3.7516356860605783`*^9}},ExpressionUUID->"320f2d10-426b-41b7-97d9-\
062f2dba7831"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"solveNBeqsAtGivenOrder", "[", 
    RowBox[{"order_", ",", "eqs_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sortedEquations", ",", "solutionOfThisEquation", ",", 
       RowBox[{"solutionAtThisOrder", "=", 
        RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"subactivity", "=", "\"\<sortEquations\>\""}], ";", 
      RowBox[{"sortedEquations", "=", 
       RowBox[{"sortEquations", "[", "eqs", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"subactivity", "=", 
          RowBox[{"\"\<solveSingleEqAtGivenOrder, number \>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\</\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"Length", "[", "sortedEquations", "]"}], "]"}]}]}], ";", 
         RowBox[{"Quiet", "[", 
          RowBox[{
           RowBox[{"solutionOfThisEquation", "=", 
            RowBox[{"solveSingleEqAtGivenOrder", "[", 
             RowBox[{"order", ",", 
              RowBox[{
              "sortedEquations", "\[LeftDoubleBracket]", "i", 
               "\[RightDoubleBracket]"}], ",", "solutionAtThisOrder"}], 
             "]"}]}], ",", 
           RowBox[{"Part", "::", "partw"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"Quiet", "[", 
            RowBox[{"solutionOfThisEquation", "=!=", 
             RowBox[{
              RowBox[{"{", "}"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"solutionAtThisOrder", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"solutionAtThisOrder", ",", "solutionOfThisEquation"}], 
             "]"}]}], ",", 
           RowBox[{
            RowBox[{"Print", "[", 
             RowBox[{"sortedEquations", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], ";", 
            RowBox[{"Return", "[", 
             RowBox[{"$Failed", ",", "Block"}], "]"}]}]}], "]"}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "sortedEquations", "]"}]}], "}"}]}], "]"}], ";",
       "\[IndentingNewLine]", "solutionAtThisOrder"}]}], 
    "\[IndentingNewLine]", "]"}]}], "*)"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.751616615091967*^9, 3.7516166204524517`*^9}, {
