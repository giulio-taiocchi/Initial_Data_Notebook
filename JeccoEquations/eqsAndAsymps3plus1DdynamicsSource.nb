Cell[BoxData[{
 RowBox[{
  RowBox[{"dottodot", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"f_", "/;", 
       RowBox[{"StringMatchQ", "[", 
        RowBox[{
         RowBox[{"ToString", "@", "f"}], ",", "\"\<*dotdot\>\""}], "]"}]}], "\[RuleDelayed]", 
      RowBox[{"dot", "[", 
       RowBox[{"dot", "[", 
        RowBox[{"ToExpression", "[", 
         RowBox[{"StringTake", "[", 
          RowBox[{
           RowBox[{"ToString", "@", "f"}], ",", 
           RowBox[{"1", ";;", 
            RowBox[{"-", "7"}]}]}], "]"}], "]"}], "]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"f_", "/;", 
       RowBox[{"StringMatchQ", "[", 
        RowBox[{
         RowBox[{"ToString", "@", "f"}], ",", "\"\<*dot\>\""}], "]"}]}], "\[RuleDelayed]", 
      RowBox[{"dot", "[", 
       RowBox[{"ToExpression", "[", 
        RowBox[{"StringTake", "[", 
         RowBox[{
          RowBox[{"ToString", "@", "f"}], ",", 
          RowBox[{"1", ";;", 
           RowBox[{"-", "4"}]}]}], "]"}], "]"}], "]"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allfcts", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", "X", "]"}], "&"}], "/@", "functs"}], ")"}], "/.", 
     "dottodot"}], "//.", "dottodt"}]}], ";"}]}], "Input",
 InitializationCell->True,
