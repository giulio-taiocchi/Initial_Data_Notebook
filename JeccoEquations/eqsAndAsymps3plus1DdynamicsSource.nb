Cell["Simplification code", "Subsection",
 CellChangeTimes->{{3.75559264622408*^9, 
  3.7555926491491737`*^9}},ExpressionUUID->"36af3439-b29b-4077-92ec-\
c861029226c8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"simplifyEqs", "[", "eqs_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Numerator", "@", 
         RowBox[{"Simplify", "[", "eqs", "]"}]}], "//.", "dottodt"}], "//.", 
       RowBox[{"restoreSpatialDerivatives", "[", "]"}]}], "/.", 
      "gSpatialSolve"}], "//.", "dttodot"}], "//.", 
    "rewriteSpatialDerivatives"}], "//", 
   RowBox[{
    RowBox[{"Collect", "[", 
     RowBox[{"#", ",", 
      RowBox[{"functsNested", "~", "Join", "~", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"{", 
            RowBox[{"r", ",", "2"}], "}"}]], 
          RowBox[{"f_", "[", "X", "]"}]}], ",", 
         RowBox[{
          OverscriptBox["_", "^"], "[", "X", "]"}], ",", 
         RowBox[{
          OverscriptBox["_", "~"], "[", "X", "]"}]}], "}"}]}], ",", 
      "Simplify"}], "]"}], "&"}]}]}], "\n", 
 RowBox[{
  RowBox[{"simplifyEquationOfFunction", "[", 
   RowBox[{"eq_", ",", "f_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     FractionBox["eq", 
      RowBox[{"Coefficient", "[", 
       RowBox[{"eq", ",", "f"}], "]"}]], "//", "Together"}], "//", 
    "Numerator"}], "//", 
   RowBox[{
    RowBox[{"Collect", "[", 
     RowBox[{"#", ",", 
      RowBox[{"functsNested", "~", "Join", "~", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Exp", "[", "_", "]"}], ",", 
         RowBox[{"S", "[", "X", "]"}]}], "}"}]}], ",", "FullSimplify"}], 
     "]"}], "&"}]}]}]}], "Input",
 InitializationCell->True,
