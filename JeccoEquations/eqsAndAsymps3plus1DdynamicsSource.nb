   RowBox[{"eomdot", "=", 
    RowBox[{
     RowBox[{"eomdotNice", 
      RowBox[{"(*", 
       RowBox[{"/.", 
        RowBox[{"Equal", "\[Rule]", "Subtract"}]}], "*)"}], "//.", 
      RowBox[{"restoreSpatialDerivatives", "[", "solNested", "]"}]}], "//", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{"#", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Exp", "[", "_", "]"}], ",", 
          RowBox[{"S", "[", "X", "]"}]}], "}"}], ",", "Simplify"}], "]"}], 
      "&"}]}]}], ";"}], "//", "AbsoluteTiming"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eomdot", "=", 
   RowBox[{"eomdot", "/.", 
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"f_", "==", "fsol_"}], "]"}], "\[RuleDelayed]", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"denom", "=", 
         RowBox[{"Denominator", "[", 
          RowBox[{"Together", "[", "fsol", "]"}], "]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"denom", " ", "f"}], " ", "\[Equal]", 
        RowBox[{"Collect", "[", " ", 
         RowBox[{
          RowBox[{"denom", " ", "fsol"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Exp", "[", "_", "]"}], ",", 
            RowBox[{"S", "[", "X", "]"}]}], "}"}], ",", "Simplify"}], 
         "]"}]}]}], "]"}]}]}]}], ";"}]}], "Input",
