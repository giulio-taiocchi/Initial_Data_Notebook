12d9cb77fb2e"],

Cell[CellGroupData[{

Cell["The parts we will subtract", "Subchapter",
 CellChangeTimes->{{3.748778488341372*^9, 
  3.748778491659565*^9}},ExpressionUUID->"4271bd99-3dd9-4e3e-b50d-\
57243813f7f9"],

Cell[CellGroupData[{

Cell["subtraction orders", "Section",
 CellChangeTimes->{{3.6574433422165537`*^9, 
  3.6574433441224623`*^9}},ExpressionUUID->"e516fb92-79cc-488a-bfd8-\
31c6495a6c69"],

Cell[TextData[{
 "We want the leading term to be something nontrivial and something physical. \
So it must be one of the modes, like \[ScriptCapitalE] or \[ScriptCapitalP], \
or a vev or something. This does it automatically.\nWe also subtract the logs \
that appear at the same order as the first mode ",
 StyleBox["Added: and the logs at the next order. NOTE: the code below in \
subtract won\[CloseCurlyQuote]t generalise to subtract log^2 terms if they \
occur",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.657443358661193*^9, 3.657443396240506*^9}, {
  3.65778684025467*^9, 3.6577868510515413`*^9}, {3.666433625060656*^9, 
  3.666433639799806*^9}, {3.666433862408594*^9, 
  3.6664338775357533`*^9}},ExpressionUUID->"8d28bf42-1598-405f-be83-\
2345a6aecf8f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"contains", "[", 
   RowBox[{"x_", ",", "list_"}], "]"}], ":=", 
  RowBox[{"Or", "@@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Not", "[", 
       RowBox[{"FreeQ", "[", 
        RowBox[{"x", ",", "#"}], "]"}], "]"}], "&"}], "/@", "list"}], 
    ")"}]}]}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.658121610364511*^9, 3.658121645397623*^9}},
 CellLabel->
  "In[230]:=",ExpressionUUID->"0fb05a35-0dd2-4238-a90e-08d216aa2d6f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"subtractOrders", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Max", "[", 
      RowBox[{"Cases", "[", 
       RowBox[{"#", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           SuperscriptBox["r", "p_"], " ", 
           RowBox[{"ff", "[", "term_", "]"}]}], "/;", 
          RowBox[{"contains", "[", 
           RowBox[{"term", ",", "modes"}], "]"}]}], "\[RuleDelayed]", "p"}]}],
        "]"}], "]"}]}], "&"}], "/@", 
   RowBox[{"Collect", "[", 
    RowBox[{"nearbdry", ",", "r", ",", "ff"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"subtractOrdersGauge", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Max", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"#", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             SuperscriptBox["r", "p_"], " ", 
             RowBox[{"ff", "[", "term_", "]"}]}], "/;", 
            RowBox[{"contains", "[", 
             RowBox[{"term", ",", 
              RowBox[{"modes", "~", "Join", "~", "gaugeparams"}]}], "]"}]}], "\[RuleDelayed]",
            "p"}]}], "]"}], "]"}]}], "&"}], "/@", 
     RowBox[{"Collect", "[", 
      RowBox[{"nearbdry", ",", "r", ",", "ff"}], "]"}]}]}], 
   "*)"}]}]}], "Input",
 InitializationCell->True,
