Cell[BoxData[
 RowBox[{
  RowBox[{"getEquationsAtOrder", "[", 
   RowBox[{"order_", ",", "logorder_", ",", "logorderIncreased_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"Not", "@", 
     RowBox[{"TrueQ", "[", "logorderIncreased", "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"getSeriesCoeff", "[", 
        RowBox[{"eqAsymptotic", ",", "order", ",", "logorder"}], "]"}], "/.", 
       
       RowBox[{
        RowBox[{
         SubscriptBox["f_", 
          RowBox[{"n_", ",", "l_"}]], "/;", 
         RowBox[{"l", ">", "logorder"}]}], "\[Rule]", 
        RowBox[{"(", 
         RowBox[{"0", "&"}], ")"}]}]}], "/.", "replnbBCs"}], "//", "Expand"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"ord", "\[Function]", 
        RowBox[{"Expand", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"getSeriesCoeff", "[", 
            RowBox[{"eqAsymptotic", ",", "ord", ",", "logorder"}], "]"}], "/.", 
           RowBox[{
            RowBox[{
             SubscriptBox["f_", 
              RowBox[{"n_", ",", "l_"}]], "/;", 
             RowBox[{"l", ">", "logorder"}]}], "\[Rule]", 
            RowBox[{"(", 
             RowBox[{"0", "&"}], ")"}]}]}], "/.", "replnbBCs"}], "]"}]}], 
       ")"}], "/@", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"order", "-", "logorder"}], ",", "order"}], "]"}]}], "//", 
     "Flatten"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 InitializationCell->True,
