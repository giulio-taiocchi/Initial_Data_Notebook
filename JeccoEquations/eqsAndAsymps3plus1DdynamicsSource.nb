3a629747738b"],

Cell[TextData[{
 "For a spatial hypersurface \[CapitalGamma] with future pointing normal \
vector ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["n", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "74a77a03-9d21-4a4b-a734-f1a610e06a53"],
 " and a surface ",
 Cell[BoxData[
  FormBox[
   RowBox[{"S", "\[Subset]", "\[CapitalGamma]"}], TraditionalForm]],
  ExpressionUUID->"1b2729f8-f5cd-453f-80b1-8321d850b94f"],
 " with outward pointing normal vector ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "d9f2bd16-817d-43fa-a7ed-176cfcb694ac"],
 ", the induced metric on S is:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["h", "\[Mu]\[Nu]"], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["g", "\[Mu]\[Nu]"], "+", 
      RowBox[{
       SubscriptBox["k", "\[Mu]"], 
       SubscriptBox["l", "\[Nu]"]}], "+", 
      RowBox[{
       SubscriptBox["l", "\[Mu]"], 
       SubscriptBox["k", "\[Nu]"]}]}], "=", 
     RowBox[{
      SubscriptBox["g", "\[Mu]\[Nu]"], "+", 
      RowBox[{
       SubscriptBox["n", "\[Mu]"], 
       SubscriptBox["n", "\[Nu]"]}], "-", 
      RowBox[{
       SubscriptBox["s", "\[Mu]"], 
       SubscriptBox["s", "\[Nu]"]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "92d73cad-df1b-4a22-9733-91969e9dac90"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "\[Mu]"], "=", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["2"]], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["n", "\[Mu]"], "+", 
       SubscriptBox["s", "\[Mu]"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"218c235e-2349-4f8f-bed6-c31bd57a7146"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["l", "\[Mu]"], "=", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["2"]], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["n", "\[Mu]"], "-", 
       SubscriptBox["s", "\[Mu]"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"1f06b1e1-545a-4d63-bf85-9da26ad9e2fa"]
}], "Text",
 CellChangeTimes->{{3.751008187533203*^9, 3.7510082193641977`*^9}, {
  3.751008253041946*^9, 3.751008291663913*^9}, {3.751008339290481*^9, 
  3.751008364242625*^9}, {3.751008397548942*^9, 
  3.751008464248239*^9}},ExpressionUUID->"41db1c9f-8f92-4f4c-af59-\
702b6851d55c"],

