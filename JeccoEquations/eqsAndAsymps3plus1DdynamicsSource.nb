80e302ed7779"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"nDynamical", "\[GreaterEqual]", "4"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"gIN", "\[LeftDoubleBracket]", 
         RowBox[{
          RowBox[{"2", "+", "i"}], ",", 
          RowBox[{"2", "+", "j"}]}], "\[RightDoubleBracket]"}], "=", 
        RowBox[{
         SubscriptBox["G", 
          RowBox[{"i", ",", "j"}]], "[", "X", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"dval", "-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"dval", "-", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gIN", "=", 
      RowBox[{
       RowBox[{"gIN", "/.", 
        RowBox[{
         RowBox[{
          SubscriptBox["G", 
           RowBox[{"i_", ",", "j_"}]], "/;", 
          RowBox[{"i", ">", "j"}]}], "\[RuleDelayed]", 
         SubscriptBox["G", 
          RowBox[{"j", ",", "i"}]]}]}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           SubscriptBox["G", 
            RowBox[{"i_", ",", "j_"}]], "/;", 
           RowBox[{
            RowBox[{"j", ">", 
