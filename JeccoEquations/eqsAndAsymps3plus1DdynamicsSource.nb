Cell[BoxData[{
 RowBox[{
  RowBox[{"replfctsu", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"replfcts", "/.", 
      RowBox[{"Function", "\[Rule]", "function"}]}], "/.", 
     RowBox[{
      RowBox[{"function", "[", 
       RowBox[{
        RowBox[{"{", "X", "}"}], ",", "expr_"}], "]"}], "\[RuleDelayed]", 
      RowBox[{"function", "[", 
       RowBox[{
        RowBox[{"{", "Xu", "}"}], ",", 
        RowBox[{
         RowBox[{"expr", "/.", 
          RowBox[{"r", "\[Rule]", 
           SuperscriptBox["u", 
            RowBox[{"-", "1"}]]}]}], "/.", 
         RowBox[{
          RowBox[{"f_", "[", 
           RowBox[{"t", ",", 
            SuperscriptBox["u", 
             RowBox[{"-", "1"}]], ",", "Xspatial"}], "]"}], "\[RuleDelayed]", 
          
          RowBox[{"f", "[", 
           RowBox[{"t", ",", "u", ",", "Xspatial"}], "]"}]}]}]}], "]"}]}]}], "/.", 
    RowBox[{"function", "\[Rule]", "Function"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"replfctsuinv", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"replinv", "/.", 
      RowBox[{"Function", "\[Rule]", "function"}]}], "/.", 
     RowBox[{
      RowBox[{"function", "[", 
       RowBox[{
        RowBox[{"{", "X", "}"}], ",", "expr_"}], "]"}], "\[RuleDelayed]", 
      RowBox[{"function", "[", 
       RowBox[{
        RowBox[{"{", "Xu", "}"}], ",", 
        RowBox[{
         RowBox[{"expr", "/.", 
          RowBox[{"r", "\[Rule]", 
           SuperscriptBox["u", 
            RowBox[{"-", "1"}]]}]}], "/.", 
         RowBox[{
          RowBox[{"f_", "[", 
           RowBox[{"t", ",", 
            SuperscriptBox["u", 
             RowBox[{"-", "1"}]], ",", "Xspatial"}], "]"}], "\[RuleDelayed]", 
          
          RowBox[{"f", "[", 
           RowBox[{"t", ",", "u", ",", "Xspatial"}], "]"}]}]}]}], "]"}]}]}], "/.", 
    RowBox[{"function", "\[Rule]", "Function"}]}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.740478152069302*^9, 3.740478164801827*^9}, {
  3.74047829487409*^9, 3.740478334766577*^9}, {3.7505032154509*^9, 
